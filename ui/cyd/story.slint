import { Theme } from "../slint/theme.slint";
import { OverlaySwallow, PressTile, Seg } from "../slint/controls.slint";
import { Geom } from "geom.slint";
import { CydPageTitle, CydBackChevron, CydStatRow } from "controls_cyd.slint";

// ============================================================================
// ENDLESS LitRPG READER (#story) — four pages, two hard limits, one rail.
// ============================================================================
//
// Design spec: ~/Projects/endlesslitrpg/docs/superpowers/specs/
//              2026-07-29-endless-litrpg-design.md §9.4 / §9.4.1
//
//   0 LIST      chapter index from /api/chapters
//   1 PLAY      streaming playback with a live "who is speaking" chip
//   2 STATS     level / XP / HP / gold / location, from /api/character
//   3 CHARACTER the 6 appear:* traits and 11 equip:* slots
//
// This was the last page ported, on purpose: it is the only file in the tree
// with TWO limits that are not about pixels at all, and both of them survived
// the port unchanged. They are restated below because the numbers moved and the
// reasons did not.
//
// ===========================================================================
// LIMIT 1 — THE PLAY PAGE IS UNDER A REAL-TIME PAINT BUDGET
// ===========================================================================
// A full-frame Slint paint on this panel is 90-170 ms (measured), while the
// audio DMA ring holds only 48 ms and nothing refills it while a paint blocks
// the single-threaded executor. Partial rendering is on, so paint cost scales
// with the DIRTY REGION — and a region only stays small if nothing MOVES or
// REFLOWS. `net::story_play::PaintGate` measures the result and trips at 30 ms;
// `worst_us` already sits at 26-30 ms of that budget, with one trip on glass.
//
// So on the PLAY page every changing element keeps FIXED geometry — same rect,
// same position, every frame — and the three changing elements stay in ONE
// CONTIGUOUS BAND. That structure is treated here as untouchable.
//
// 🟢 The port actually TIGHTENS it. On the C6 the band runs chip y214..258,
// track y282..290, times y300..318 — 104 px tall with 24 px and 10 px of dead
// gap inside it. Here it is y64..142: **78 px, gaps of 8 px and 4 px.** A
// smaller contiguous band is a smaller dirty region, so the landscape layout
// gives the paint gate margin it did not have. That is the one place in this
// port where the smaller panel is a straightforward win.
//
// ⚠️ NOT cleaned up, deliberately: the speaker chip's Text keeps its intrinsic
// -width horizontal centring. `letter-spacing` is set on it, and the audit
// measured that trailing letter-space counts toward intrinsic width but not
// toward alignment — switching methods shifts glyphs ~1 px. On a hot band a 1 px
// shift is a re-layout, which is the opposite of the point. The VERTICAL
// centring uses the cheap form, which the same audit proved pixel-identical.
//
// ===========================================================================
// LIMIT 2 — THE CHARACTER WINDOW IS AN OOM BOUNDARY, NOT A LAYOUT CHOICE
// ===========================================================================
// Rendering all 17 slots at once is not a heavy screen, it is a REBOOT: two of
// two hardware trials reset the watch. `PrepareScene` emits one scene item AND
// one texture per rendered GLYPH and its vectors grow by powers of two, so
// crossing 256 textures asks esp-alloc for **14,336 B contiguous**, which the
// reclaimed pool cannot serve out of a sum of holes. It fails during the tap.
//
// 🟥 So: SIX ROWS, and not one more. The rule as written is *"you may show FEWER
// rows; you may NEVER show more; a 2-column landscape grid of 8 slots is
// FORBIDDEN — that is the exact configuration that rebooted it twice."*
//
// This page shows exactly SIX, at 25 px instead of 40. Landscape is the obvious
// place to reach for two columns and that is precisely the forbidden move; the
// row height is what gives instead. `mod(i, 6)` / `floor(i / 6)` windowing is
// preserved verbatim, including the reason it is not `i < 6 ? i : i - 6`: Slint
// does not dedup dependency registrations, so re-reading the loop index in the
// same expression allocates again — A/B measured at +22 nodes / 352 B on device
// for an identical result.
//
// ===========================================================================
// THE TABS BECAME A RIGHT RAIL, AND THAT IS WHAT PAID FOR EVERYTHING
// ===========================================================================
// The C6 tab row is a full-width 34 px band at y96. Four tabs stacked on a
// right rail cost 54 px of the axis that fell 22 % and hand back 40 px of the
// axis that fell 52 %. Every page in this file is tight enough that those 40 px
// are the difference between fitting and reshaping — the CHARACTER window in
// particular only holds six rows because of them.
//
// It also matches `shell.slint`'s carousel rail and the settings hub's page
// rail, so the third rail in the UI is the third instance of one idiom rather
// than a new one.
//
// ⚠️ TWO-SIDED CONSTANTS ON THIS PAGE
//   `board::ui::STORY_PAUSE_RECT` — main.rs hit-tests PAUSE inline and its own
//   comment warns the geometry *"must match story.slint's READ-page tiles
//   exactly"*, because *"a stale constant here mis-routes a tap"*. It is
//   currently `(0,0,0,0)` on the C5, which GATES STORY PLAYBACK OFF — so nobody
//   can ship a mis-mapped story page by accident. PAUSE is now x8..125,
//   y168..224; the tuple order is `(x0, x1, y0, y1)`, so: **(8, 125, 168, 224)**.
//   `VISIBLE_CHAPTERS` — 5 -> 3 (`Geom.max-chapters`). It is ALSO the pager
//   stride, so NEWER/OLDER paging behaviour changes with it.
// Both in PROPOSED-board-ui-consts.md.
//
// 🔶 DIRECTOR NOTE IS DROPPED. It is a push-to-talk voice note that reuses the
// STT path — which needs the microphone this board does not have. The `note()`
// callback stays declared; the button would have been a control that cannot
// work, on the one page in the tree with no spare pixels to waste on one.
// ============================================================================

// One row of the chapter index. Capped to what the list actually draws — #75's
// lesson is that the apps-menu OOM was a DRAWN-ITEM-COUNT problem, so this list
// pages through a small window rather than instantiating every chapter.
export struct StoryChapter {
    number: int,
    title: string,
    duration: string,
    playable: bool,
    current: bool,
}

// A label/value pair: an inventory line, an equipment slot, an appearance trait.
export struct StorySlot {
    label: string,
    value: string,
    known: bool,
}

export component StoryPage {
    // ---- navigation ----
    in property <int> page: 0;
    callback close();
    callback nav(int);

    // ---- LIST ----
    in property <[StoryChapter]> chapters;
    in property <bool> loading: false;
    in property <string> error-text;
    in property <int> more-count: 0;
    callback pick(int);
    callback page-prev();
    callback page-next();

    // ---- PLAY ----
    in property <string> play-title;
    in property <string> speaker;
    in property <int> speaker-kind: 0; // 0 narrator · 1 system · 2 dialogue · 3 unknown
    in property <float> progress: 0.0;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    in property <int> seg-index: 0;
    in property <int> seg-count: 0;
    in property <bool> playing: false;
    in property <bool> no-manifest: false;
    in property <bool> highlight-off: false;
    callback stop();
    callback pause();
    callback resume();
    in property <bool> paused: false;

    // ---- STATS / CHARACTER ----
    in property <string> subject;
    in property <string> level: "—";
    in property <string> xp: "—";
    in property <string> gold: "—";
    in property <string> location: "—";
    in property <string> status;
    in property <string> hp-text: "—";
    in property <float> hp-frac: 0.0;
    in property <bool> hp-known: false;
    in property <[StorySlot]> equipment;
    in property <[StorySlot]> appearance;
    in property <int> equipped-count: 0;
    in property <int> appearance-count: 0;
    // Declared, never emitted — see the DIRECTOR NOTE note in the header.
    callback note();

    // ---- fixed geometry ----------------------------------------------------
    // LITERALS, so every expression built from them is constant-folded and emits
    // no binding at all. The C6 file measured the alternative: swapping these to
    // `root.width - 2 * Theme.safe-side` cost +6 allocations and +336 B on the
    // host harness, with ZERO change in dependency-node count — `root.width` is
    // compile-time constant on a fixed-size window and a constant property is
    // marked `const_sentinel()`, so reading it never registers a dependency. The
    // saving is one binding holder per row, not a node per read.
    //
    // Affordable only because the panel never resizes, so the arithmetic is a
    // fact rather than a measurement. Named rather than scattered so it stays
    // auditable: if the panel changes, THIS is the edit.
    property <length> cw: 242px;   // 320 - safe-side(8) - rail(54) - gap(16)
    property <length> rail-x: 258px;

    Rectangle { width: 100%; height: 100%; background: Theme.bg; }
    OverlaySwallow {} // #54: chrome beneath must never be hit-testable

    CydPageTitle {
        title: root.page == 0 ? "STORY"
             : root.page == 1 ? "READING"
             : root.page == 2 ? "STATS" : "CHARACTER";
    }
    CydBackChevron { clicked => { root.close(); } }

    // ==================== page tabs — the right rail ====================
    // Fixed, always present, so switching pages never reflows the chrome.
    // Absolute rather than a layout: four fixed-size Segs need no measuring, and
    // the C6's HorizontalLayout here read four Texts' intrinsic widths on a page
    // whose whole design is about not re-laying-out.
    Seg { x: root.rail-x; y:  36px; width: 54px; height: 44px;
          label: "LIST";  active: root.page == 0; tapped => { root.nav(0); } }
    Seg { x: root.rail-x; y:  84px; width: 54px; height: 44px;
          label: "READ";  active: root.page == 1; tapped => { root.nav(1); } }
    Seg { x: root.rail-x; y: 132px; width: 54px; height: 44px;
          label: "STATS"; active: root.page == 2; tapped => { root.nav(2); } }
    Seg { x: root.rail-x; y: 180px; width: 54px; height: 44px;
          label: "CHAR";  active: root.page == 3; tapped => { root.nav(3); } }

    // ==================== 0 — chapter list ====================
    if root.page == 0 && root.loading: Text {
        x: Geom.content-x; y: 110px; width: root.cw;
        horizontal-alignment: center;
        text: "Loading\u{2026}";
        color: Theme.dim;
        font-size: 20px;
    }

    if root.page == 0 && root.error-text != "": Text {
        x: Geom.content-x; y: 100px; width: root.cw;
        horizontal-alignment: center;
        wrap: word-wrap;
        text: root.error-text;
        color: Theme.warn;
        font-size: 16px;
    }

    // THREE rows at 42 px (`Geom.max-chapters`, JP's default; was five at 50).
    // ⚠️ Rust pushes at most `VISIBLE_CHAPTERS`, which is ALSO the pager stride —
    // so this layout and that constant must move together, and NEWER/OLDER
    // paging behaviour changes when they do.
    //
    // Absolute rows, not the C6's VerticalLayout: three rows of four Texts each
    // is the shape a layout manager measures most expensively.
    if root.page == 0 && !root.loading && root.error-text == "": Rectangle {
        x: Geom.content-x; y: 36px; width: root.cw; height: 134px;
        for ch[i] in root.chapters: PressTile {
            visible: i < Geom.max-chapters;
            x: 0;
            y: i * 46px;
            width: parent.width;
            height: 42px;
            enabled: ch.playable;
            rest-background: ch.current ? Theme.accent-bg : Theme.panel;
            clicked => { root.pick(ch.number); }

            // Chapter number, fixed-width gutter so titles align.
            Text {
                x: 8px;
                y: 0; height: parent.height; vertical-alignment: center;
                width: 28px;
                horizontal-alignment: right;
                text: ch.number;
                color: ch.current ? Theme.accent : Theme.dim;
                font-size: 16px;
                font-weight: 600;
            }
            Text {
                x: 44px;
                y: 5px;
                width: parent.width - 44px - 56px;
                text: ch.title;
                color: ch.playable ? Theme.ink : Theme.faint;
                font-size: Geom.t-body;
                overflow: elide;
            }
            Text {
                x: 44px;
                y: 24px;
                text: ch.duration;
                color: Theme.dim;
                font-size: Geom.t-caption;
            }
            // Audio dot: filled when there is PCM to stream, hollow when the
            // chapter exists as text only.
            Rectangle {
                x: parent.width - 22px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: ch.playable ? Theme.accent : Theme.bg;
                border-width: ch.playable ? 0px : 1px;
                border-color: Theme.line;
            }
        }
    }

    // The honest overflow count. Kept on its own line above the pager rather than
    // folded into it: "+24 more" is the answer to "is this all of them", and it
    // must not be a thing you discover by pressing something.
    if root.page == 0 && root.more-count > 0: Text {
        x: Geom.content-x; y: 172px; width: root.cw;
        horizontal-alignment: center;
        text: "+" + root.more-count + " more";
        color: Theme.faint;
        font-size: Geom.t-caption;
    }

    // Pager. 44 px tall — the C6's was 34, under the floor; landscape gives it
    // back because the list above lost two rows.
    if root.page == 0 && root.chapters.length > 0: Seg {
        x: Geom.content-x; y: 190px; width: 117px; height: 44px;
        label: "\u{2039} NEWER"; tapped => { root.page-prev(); }
    }
    if root.page == 0 && root.chapters.length > 0: Seg {
        x: 133px; y: 190px; width: 117px; height: 44px;
        label: "OLDER \u{203a}"; tapped => { root.page-next(); }
    }

    // ==================== 1 — playback ====================
    // Chapter title: STATIC during playback, kept clear of the changing band.
    if root.page == 1: Text {
        x: Geom.content-x;
        y: 38px;
        width: root.cw;
        horizontal-alignment: center;
        text: root.play-title;
        color: Theme.ink;
        font-size: Geom.t-body;
        overflow: elide;
    }

    // ---- THE CHANGING BAND: y64..142, one contiguous region ----------------
    // Speaker chip. FIXED 200x40 regardless of the name inside it — a chip that
    // resized to its text would dirty a different rect on every segment and
    // defeat the partial-render budget. 260x44 -> 200x40; the widest realistic
    // speaker ("Narrator", 8 chars at 19 px ≈ 80 px) has room to spare, and
    // `elide` is the backstop.
    if root.page == 1 && !root.no-manifest: Rectangle {
        x: Geom.content-x + (root.cw - 200px) / 2;
        y: 64px;
        width: 200px;
        height: 40px;
        border-radius: 20px;
        background: root.speaker-kind == 1 ? Theme.track : Theme.accent-bg;
        border-width: 1px;
        border-color: root.speaker-kind == 1 ? Theme.line : Theme.accent;
        clip: true;

        // ⚠️ The horizontal centring stays an intrinsic-width read. See the
        // header: letter-spacing is set here, and switching to alignment-based
        // centring shifts glyphs ~1 px — which on a hot band is a re-layout.
        // The VERTICAL centring uses the cheap form (proven pixel-identical).
        Text {
            x: (parent.width - self.width) / 2;
            height: parent.height;
            vertical-alignment: center;
            text: root.speaker;
            color: root.speaker-kind == 1 ? Theme.soft : Theme.accent;
            font-size: 19px;
            font-weight: 600;
            letter-spacing: root.speaker-kind == 1 ? 3px : 1px;
            overflow: elide;
        }
    }
    // No trustworthy manifest: say so rather than showing a blank chip.
    if root.page == 1 && root.no-manifest: Text {
        x: Geom.content-x; y: 74px; width: root.cw;
        horizontal-alignment: center;
        text: "no segment data";
        color: Theme.faint;
        font-size: Geom.t-body;
    }

    // Progress track: fixed rect; only the fill's width changes.
    if root.page == 1: Rectangle {
        x: Geom.content-x;
        y: 112px;
        width: root.cw;
        height: 8px;
        border-radius: 4px;
        background: Theme.track;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * clamp(root.progress, 0.0, 1.0);
            height: parent.height;
            border-radius: 4px;
            background: Theme.accent;
        }
    }

    // Times: fixed-width boxes with fixed alignment, so a digit change never
    // shifts anything. All three share y124, which is what makes the band one
    // region instead of three.
    if root.page == 1: Text {
        x: Geom.content-x;
        y: 124px;
        width: 70px;
        horizontal-alignment: left;
        text: root.elapsed;
        color: Theme.soft;
        font-size: Geom.t-body;
    }
    if root.page == 1: Text {
        x: Geom.content-x + root.cw - 70px;
        y: 124px;
        width: 70px;
        horizontal-alignment: right;
        text: root.total;
        color: Theme.dim;
        font-size: Geom.t-body;
    }
    // Same hot-band rule as the chip — but no letter-spacing here, so
    // alignment-based centring IS safe on this one (the ~1 px shift the audit
    // measured only occurs where letter-spacing is set). The full-width box does
    // not enlarge the band: the progress track above already spans it.
    if root.page == 1 && root.seg-count > 0: Text {
        x: Geom.content-x;
        y: 124px;
        width: root.cw;
        horizontal-alignment: center;
        text: root.seg-index + " / " + root.seg-count;
        color: Theme.faint;
        font-size: 14px;
    }
    // ---- end of the changing band -----------------------------------------

    // Highlighting was switched off to protect the audio. Visible on purpose: a
    // cosmetic feature that stops without saying so becomes a bug report.
    if root.page == 1 && root.highlight-off: Text {
        x: Geom.content-x; y: 146px; width: root.cw;
        horizontal-alignment: center;
        text: "highlighting paused (audio priority)";
        color: Theme.faint;
        font-size: Geom.t-caption;
    }

    // Stop: the escape hatch. Playback parks the main loop for up to 18 minutes,
    // and JP has been chasing "the watch is frozen" reports that were really
    // responsive firmware behind a stuck-looking UI. A visible stop turns "it's
    // frozen" into "I stopped it" — painted BEFORE audio starts, never during.
    //
    // ⚠️ THE PAUSE TILE IS HIT-TESTED IN RUST TOO. `board::ui::STORY_PAUSE_RECT`
    // must be (8, 125, 168, 224) — tuple order (x0, x1, y0, y1). It is (0,0,0,0)
    // today, which gates C5 playback off; that gate is the only thing preventing
    // a mis-mapped tap, because at the C6's y378..438 EVERY tap on this panel
    // would fall through to STOP and PAUSE would simply vanish.
    if root.page == 1 && root.playing: PressTile {
        x: Geom.content-x;
        y: 168px;
        width: 117px;
        height: 56px;
        ignite: Theme.accent;
        clicked => { root.pause(); }
        Text {
            x: (parent.width - self.width) / 2;
            y: 0; height: parent.height; vertical-alignment: center;
            text: "PAUSE";
            color: Theme.accent;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 2px;
        }
    }
    if root.page == 1 && root.playing: PressTile {
        x: 133px;
        y: 168px;
        width: 117px;
        height: 56px;
        ignite: Theme.warn;
        clicked => { root.stop(); }
        Text {
            x: (parent.width - self.width) / 2;
            y: 0; height: parent.height; vertical-alignment: center;
            text: "STOP";
            color: Theme.warn;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 2px;
        }
    }

    // Paused: RESUME takes the full width, because there is nothing to STOP — the
    // stream is already closed and the position is just a number being held. A
    // STOP here would only mean "forget where I was", which the LIST tab does.
    if root.page == 1 && root.paused && !root.playing: PressTile {
        x: Geom.content-x;
        y: 168px;
        width: root.cw;
        height: 56px;
        ignite: Theme.accent;
        clicked => { root.resume(); }
        Text {
            x: (parent.width - self.width) / 2;
            y: 0; height: parent.height; vertical-alignment: center;
            text: "RESUME";
            color: Theme.accent;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 2px;
        }
    }
    if root.page == 1 && !root.playing && !root.paused: Text {
        x: Geom.content-x; y: 184px; width: root.cw;
        horizontal-alignment: center;
        text: "tap a chapter in LIST to play";
        color: Theme.dim;
        font-size: Geom.t-body;
    }

    // ==================== 2 — stats ====================
    if root.page == 2: Text {
        x: Geom.content-x; y: 38px; width: root.cw;
        overflow: elide;
        text: root.subject;
        color: Theme.accent;
        font-size: 20px;
        font-weight: 600;
    }

    // HP — the label/value line and the bar, as one block.
    if root.page == 2: Rectangle {
        x: Geom.content-x; y: 64px; width: root.cw; height: 34px;
        Text {
            x: 0; y: 0; height: 20px; vertical-alignment: center;
            text: "HP";
            color: Theme.dim;
            font-size: Geom.t-label;
            letter-spacing: 2px;
        }
        Text {
            x: parent.width - self.width; y: 0;
            height: 20px; vertical-alignment: center;
            text: root.hp-text;
            color: root.hp-known ? Theme.ink : Theme.faint;
            font-size: Geom.t-value;
            font-weight: 600;
        }
        // The bar is SUPPRESSED when hp is unknown. The live ledger has hp: null
        // against max_hp: 110, and a bar drawn at zero would assert the
        // protagonist is dead.
        if root.hp-known: Rectangle {
            x: 0; y: 24px;
            width: parent.width; height: 8px;
            border-radius: 4px;
            background: Theme.track;
            Rectangle {
                x: 0; y: 0;
                width: parent.width * clamp(root.hp-frac, 0.0, 1.0);
                height: parent.height;
                border-radius: 4px;
                background: root.hp-frac < 0.25 ? Theme.warn : Theme.accent;
            }
        }
        // Unknown: an empty OUTLINED track reads as "no data", which is
        // deliberately different from a zero-width fill on a live track.
        if !root.hp-known: Rectangle {
            x: 0; y: 24px;
            width: parent.width; height: 8px;
            border-radius: 4px;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.line;
        }
    }

    if root.page == 2: CydStatRow {
        x: Geom.content-x; y: 102px; width: root.cw; height: 26px;
        label: "LEVEL"; value: root.level;
    }
    if root.page == 2: CydStatRow {
        x: Geom.content-x; y: 130px; width: root.cw; height: 26px;
        label: "XP"; value: root.xp;
    }
    if root.page == 2: CydStatRow {
        x: Geom.content-x; y: 158px; width: root.cw; height: 26px;
        label: "GOLD"; value: root.gold;
        value-color: root.gold == "—" ? Theme.faint : Theme.warm;
    }
    if root.page == 2: CydStatRow {
        x: Geom.content-x; y: 186px; width: root.cw; height: 26px;
        label: "LOCATION"; value: root.location;
    }
    // Single ELIDED line. Word-wrap here would grow to two lines and overdraw
    // the row above — the same collision the C6 file records having hit.
    if root.page == 2 && root.status != "": Text {
        x: Geom.content-x;
        y: 214px;
        width: root.cw;
        height: 18px;
        horizontal-alignment: center;
        overflow: elide;
        text: root.status;
        color: Theme.soft;
        font-size: Geom.t-caption;
    }

    // ==================== 3 — character ====================
    // Text-and-icon panel, NOT a composited portrait: the layered art does not
    // exist and a full-panel RGB565 frame is not free even with PSRAM. Reserved
    // as Phase 2b (design §9.4.1).
    //
    // 🟥 SIX ROWS. See LIMIT 2 in the header — this is the OOM boundary, and the
    // forbidden move is exactly the one landscape invites (two columns of eight).
    // The row height gives instead: 40 -> 25 px, six rows in 150 px.

    // Which slice of the sheet is on screen: 0 appearance · 1 equipment 1-6 ·
    // 2 equipment 7-11. Local UI state — Rust neither sets nor needs it, so it
    // stays out of the shell's property surface.
    property <int> char-view: 0;
    // Which half of the 11 equipment slots view 1/2 shows. Compared against
    // `floor(i / 6)` per row, which is ONE read of the loop index instead of the
    // two an `i >= start && i < start + 6` pair would take.
    property <int> gear-page: root.char-view == 2 ? 1 : 0;

    // View switcher: ONE cycling chip, not three Segs.
    //
    // The C6 uses a 3-Seg row 30 px tall. That band does not exist here — the
    // tab rail already took the width and the six-row window needs the height —
    // so the switcher becomes a cycle (the settings BUTTONS-page idiom). It
    // carries its POSITION in the label ("APPEAR 1/3") precisely because a cycle
    // otherwise hides how many views there are, which is the one thing three
    // visible Segs told you for free.
    if root.page == 3: PressTile {
        x: Geom.content-x; y: 36px; width: 120px; height: 44px;
        border-radius: 12px;
        clicked => { root.char-view = mod(root.char-view + 1, 3); }
        Text {
            x: (parent.width - self.width) / 2;
            y: 0; height: parent.height; vertical-alignment: center;
            text: root.char-view == 0 ? "APPEAR 1/3"
                : (root.char-view == 1 ? "GEAR I 2/3" : "GEAR II 3/3");
            color: Theme.accent;
            font-size: Geom.t-label;
            font-weight: 600;
            letter-spacing: 1px;
        }
    }

    // How much of the sheet the ledger has actually filled. Kept visible in
    // every view: it is the difference between "the fetch returned nothing" and
    // "this character genuinely wears nothing", which em-dashes alone cannot
    // say. Moved from a footer line to the switcher's row — landscape has the
    // width, and the count belongs beside the view it counts.
    if root.page == 3: Text {
        x: 136px; y: 36px; width: 114px;
        height: 44px; vertical-alignment: center;
        horizontal-alignment: right;
        text: root.char-view == 0
            ? root.appearance-count + "/6 known"
            : root.equipped-count + "/11 known";
        color: Theme.faint;
        font-size: Geom.t-caption;
    }

    // The six appearance traits — all of them, so this view needs no window.
    if root.page == 3 && root.char-view == 0: Rectangle {
        x: Geom.content-x;
        y: 84px;
        width: root.cw;
        height: 150px; // 6 rows x 25px
        for tr[i] in root.appearance: Rectangle {
            x: 0;
            y: i * 25px;
            width: root.cw;
            height: 25px;
            // Centred by a LITERAL box height plus vertical-alignment, never by
            // `(parent.height - self.height) / 2` — that reads two live
            // properties, so on a repeated row it is two more 16 B dependency
            // nodes per Text, per row, for an identical result on a fixed row.
            Text {
                x: 0;
                y: 0;
                height: 25px;
                vertical-alignment: center;
                text: tr.label;
                color: Theme.dim;
                font-size: Geom.t-caption;
            }
            // The value column is 170 px. Worth stating plainly: the C6 gives it
            // 258 px (~32 chars) and its comment records that the two-column
            // grid's 111 px column elided a 24-char name to about thirteen — a
            // real display bug, not a nicety. 170 px is ~22 chars: better than
            // the configuration that was broken, worse than the one that fixed
            // it. The daemon's naming runs 22-28 chars, so the longest names
            // still elide. That is the residual cost of this panel and it is
            // recorded rather than hidden.
            Text {
                x: 72px;
                y: 0;
                height: 25px;
                vertical-alignment: center;
                width: root.cw - 72px;
                text: tr.known ? tr.value : "—";
                color: tr.known ? Theme.ink : Theme.faint;
                font-size: Geom.t-body;
                overflow: elide;
            }
        }
    }

    // Equipment, windowed. The repeater still walks all eleven slots — one array
    // stays the source of truth — but a row outside the current window renders
    // NO Text children, and a glyph that is never emitted is never a scene item.
    if root.page == 3 && root.char-view != 0: Rectangle {
        x: Geom.content-x;
        y: 84px;
        width: root.cw;
        height: 150px;
        for sl[i] in root.equipment: Rectangle {
            x: 0;
            // mod()/floor() rather than `i < 6 ? i : i - 6`. Slint does not dedup
            // dependency registrations — `register_as_dependency_to_current_binding`
            // allocates unconditionally per read — so re-reading the loop index in
            // the same expression allocates again. A/B measured on these 11 rows:
            // the conditional form costs +22 nodes, 352 B on the device, for an
            // identical result.
            y: mod(i, 6) * 25px;
            width: root.cw;
            height: 25px;
            if floor(i / 6) == root.gear-page: Rectangle {
                Text {
                    x: 0;
                    y: 0;
                    height: 25px;
                    vertical-alignment: center;
                    text: sl.label;
                    color: Theme.dim;
                    font-size: Geom.t-caption;
                }
                Text {
                    x: 72px;
                    y: 0;
                    height: 25px;
                    vertical-alignment: center;
                    width: root.cw - 72px;
                    text: sl.known ? sl.value : "—";
                    color: sl.known ? Theme.ink : Theme.faint;
                    font-size: Geom.t-body;
                    overflow: elide;
                }
            }
        }
    }
}
