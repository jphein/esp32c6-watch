import { Theme, PageTitle } from "theme.slint";
import { OverlaySwallow, BackChevron, PressTile, Stepper, Seg } from "controls.slint";

// HA Climate control screen (design spec §C). Standalone overlay — renders
// through the resident scene like WLED/Energy (no framebuffer). Two views:
// a dynamic card LIST, and a DETAIL with setpoint steppers + a mode selector.
// Pure presentation: the climate-model + MQTT/Node-RED bridge live in the loop;
// this emits set-temp / set-mode and reflects the pushed `cards` model.
// NOT wired into WatchShell yet (integrator adds AppState::Climate + tile).
//
// === Rust↔Slint contract (match this in the wiring) ===
//   struct ClimateCard { id, name, cur, setpoint, mode, action, min, max, step,
//                        modes-mask, unit } — see below.
//   in  property <[ClimateCard]> cards        // VecModel, one per entity (0..N)
//   in  property <int>  conn-state            // 0 ready · 1 connecting · 2 unreachable
//   in-out property <int> selected-index      // -1 = list · >=0 = detail on that card
//   callback set-temp(int, float)             // (id, new-setpoint) — clamped in UI
//   callback set-mode(int, int)               // (id, hvac-mode 0..5)
//   callback closed()                         // list back-chevron / right-swipe → mesh
// mode ids: 0 off · 1 heat · 2 cool · 3 auto · 4 fan · 5 dry
// action ids: 0 idle · 1 heating · 2 cooling   modes-mask: bit m set = mode m supported

export struct ClimateCard {
    id: int,
    name: string,
    cur: string,        // Rust-formatted current temp, e.g. "72" ("--" if unknown)
    setpoint: float,    // numeric setpoint (stepper + display)
    mode: int,          // current hvac mode 0..5
    action: int,        // hvac action 0 idle / 1 heating / 2 cooling
    min: float,
    max: float,
    step: float,
    modes-mask: int,    // supported modes bitmask (bit m = mode m)
    unit: string,       // "°F" (passthrough, no conversion)
}

// The mode chips are the shared `Seg` (controls.slint, Recipe E) — this file's
// old ModeSeg was the pattern's reference implementation; its press `animate`s
// are retired per the design spec §8 (a tween at 6-11 fps is a 1-step jump that
// queues wasted full repaints — hard swap only).

export component ClimateOverlay {
    in property <[ClimateCard]> cards;
    in property <int> conn-state: 0;
    in-out property <int> selected-index: -1;
    callback set-temp(int, float);
    callback set-mode(int, int);
    callback closed();

    // hvac-action → accent (heating amber, cooling blue, idle neutral).
    pure function action-color(a: int) -> color {
        a == 1 ? Theme.warm : (a == 2 ? Theme.accent2 : Theme.dim)
    }
    pure function action-label(a: int) -> string {
        a == 1 ? "HEATING" : (a == 2 ? "COOLING" : "IDLE")
    }
    pure function mode-label(m: int) -> string {
        m == 0 ? "OFF" : (m == 1 ? "HEAT" : (m == 2 ? "COOL"
            : (m == 3 ? "AUTO" : (m == 4 ? "FAN" : "DRY"))))
    }
    // Slint has no bitwise ops → arithmetic bit test: bit for divisor 2^m set?
    pure function bit-set(mask: int, div: int) -> bool {
        mod(floor(mask / div), 2) == 1
    }
    // Safe index for the always-present (opacity-gated) detail layer — never OOB
    // even when selected-index is -1 (list mode); the layer is just invisible then.
    property <int> di: clamp(root.selected-index, 0, max(0, root.cards.length - 1));

    Rectangle { width: 100%; height: 100%; background: Theme.bg; }
    OverlaySwallow {} // #54: chrome beneath must never be hit-testable

    PageTitle { title: "CLIMATE"; }

    // Back chevron — shared BackChevron component (controls.slint): one canonical
    // 78x64 placement (fixes the old climate x8/y6 vs others x14/y8 drift; P3).
    // In detail → back to list; in list → close (return to mesh).
    BackChevron {
        clicked => {
            if (root.selected-index >= 0) { root.selected-index = -1; }
            else { root.closed(); }
        }
    }

    // ==================== states ====================
    if root.conn-state == 1: Text {
        x: (parent.width - self.width) / 2; y: 230px;
        text: "connecting\u{2026}"; color: Theme.dim; font-size: 20px; letter-spacing: 1px;
    }
    if root.conn-state == 2: Text {
        x: (parent.width - self.width) / 2; y: 230px;
        text: "HA unreachable"; color: Theme.warn; font-size: 20px; font-weight: 600;
    }
    if root.conn-state == 0 && root.cards.length == 0: Text {
        x: (parent.width - self.width) / 2; y: 230px;
        text: "no climate devices"; color: Theme.dim; font-size: 18px; letter-spacing: 1px;
    }

    // ==================== LIST view ====================
    // LIST layer — present when ready+non-empty; fades/slides under the detail
    // on selection (crossfade). Card taps disabled while the detail is up.
    if root.conn-state == 0 && root.cards.length > 0: Flickable {
        x: root.selected-index < 0 ? 22px : 4px;
        y: 96px;
        width: parent.width - 44px;
        height: parent.height - 112px;
        opacity: root.selected-index < 0 ? 1.0 : 0.0;
        animate x, opacity { duration: 200ms; easing: ease-out; }
        viewport-height: root.cards.length * 104px;
        VerticalLayout {
            spacing: 12px;
            // PressTile (Recipe A): the row lights on finger-down — the tap used
            // to wait ~200ms for the detail crossfade before ANY acknowledgment.
            // Disabled (with its TA) in detail mode, so no ghost flashes under
            // the detail layer.
            for card[idx] in root.cards: PressTile {
                height: 92px;
                enabled: root.selected-index < 0;
                clicked => { root.selected-index = idx; }
                // action accent bar (left) — hard swap, animate retired (§8).
                Rectangle {
                    x: 0; y: 10px; width: 5px; height: parent.height - 20px;
                    border-radius: 2.5px;
                    background: root.action-color(card.action);
                }
                // name
                Text {
                    x: 20px; y: 16px; width: parent.width - 190px; overflow: elide;
                    text: card.name; color: Theme.soft; font-size: 18px; font-weight: 600;
                }
                // setpoint (small)
                Text {
                    x: 20px; y: 52px;
                    text: "set \{round(card.setpoint)}\{card.unit}";
                    color: Theme.dim; font-size: 14px;
                }
                // big current temp (right). 40px, NOT 38: every distinct
                // font-size embeds a whole pre-rendered glyph set (~70KB at
                // this size) and 40px already exists (clock seconds) — the
                // v0.9.0 ROM squeeze consolidated the near-duplicates.
                Text {
                    x: parent.width - self.width - 74px; y: (parent.height - self.height) / 2;
                    text: card.cur + card.unit;
                    color: Theme.ink; font-size: 40px; font-weight: 700;
                }
                // mode chip (top-right)
                Rectangle {
                    x: parent.width - self.width - 16px; y: 14px;
                    width: 56px; height: 24px; border-radius: 12px;
                    background: Theme.track;
                    Text {
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        text: root.mode-label(card.mode);
                        color: root.action-color(card.action) == Theme.dim ? Theme.soft : root.action-color(card.action);
                        font-size: 12px; font-weight: 600;
                    }
                }
            }
        }
    }

    // ==================== DETAIL view ====================
    // DETAIL layer — present when cards exist; own black bg occludes the list;
    // fades + slides in on selection (crossfade with the list).
    if root.cards.length > 0: Rectangle {
        opacity: root.selected-index >= 0 ? 1.0 : 0.0;
        x: root.selected-index >= 0 ? 0 : 18px;
        animate x, opacity { duration: 200ms; easing: ease-out; }
        // No own bg: the root black bg is the backdrop and the list layer is
        // opacity-gated to invisible in detail mode, so nothing bleeds through —
        // and (crucially) the always-on CLIMATE title + back-chevron, declared
        // above these layers, stay visible on top instead of being occluded.
        // device name — bounded + elided so long names never overflow the panel.
        Text {
            x: (parent.width - self.width) / 2; y: 100px;
            width: parent.width - 96px;
            horizontal-alignment: center;
            overflow: elide;
            text: root.cards[root.di].name;
            color: Theme.soft; font-size: 20px; letter-spacing: 1px;
        }
        // hero current temp + action. 84px, NOT 76: glyph-set consolidation
        // round 2 (v0.9.0 ROM squeeze) — 84px already exists (AOD/meter
        // heroes) and a distinct 76px set costs ~160KB of ROM.
        Text {
            x: (parent.width - self.width) / 2; y: 132px;
            text: root.cards[root.di].cur + root.cards[root.di].unit;
            color: Theme.ink; font-size: 84px; font-weight: 700;
        }
        Text {
            x: (parent.width - self.width) / 2; y: 224px;
            text: root.action-label(root.cards[root.di].action);
            color: root.action-color(root.cards[root.di].action) == Theme.dim
                ? Theme.dim : root.action-color(root.cards[root.di].action);
            font-size: 15px; letter-spacing: 2px;
        }

        // setpoint stepper: −  [ NN° ]  + — shared Stepper (Recipe C): pressed
        // is a FULL INVERT to solid accent with the glyph in on-accent, the
        // boldest 1-frame delta for a repeat-tap control. 72x72 finger targets.
        minus := Stepper {
            x: 40px; y: 258px; width: 72px; height: 72px;
            glyph: "\u{2212}";
            glyph-size: 40px;
            enabled: root.selected-index >= 0;
            clicked => {
                root.set-temp(root.cards[root.di].id,
                    clamp(root.cards[root.di].setpoint - root.cards[root.di].step,
                          root.cards[root.di].min, root.cards[root.di].max));
            }
        }
        // 50px, NOT 46 (glyph-set consolidation — 50px already exists via
        // hunt.slint; a distinct 46px set costs ~98KB of ROM).
        Text {
            x: (parent.width - self.width) / 2; y: 268px;
            text: "\{round(root.cards[root.di].setpoint * 10) / 10}\{root.cards[root.di].unit}";
            color: Theme.accent; font-size: 50px; font-weight: 700;
        }
        plus := Stepper {
            x: parent.width - self.width - 40px; y: 258px; width: 72px; height: 72px;
            glyph: "+";
            glyph-size: 40px;
            enabled: root.selected-index >= 0;
            clicked => {
                root.set-temp(root.cards[root.di].id,
                    clamp(root.cards[root.di].setpoint + root.cards[root.di].step,
                          root.cards[root.di].min, root.cards[root.di].max));
            }
        }

        // mode segmented control — only the device's supported modes. Wrapped in
        // `if selected>=0` so the segments don't exist (and can't catch taps) in
        // list mode while the detail layer is faded out beneath... over the list.
        if root.selected-index >= 0: HorizontalLayout {
            x: 30px; y: 366px; width: parent.width - 60px; height: 62px; spacing: 6px;
            if root.bit-set(root.cards[root.di].modes-mask, 1): Seg {
                label: "OFF"; active: root.cards[root.di].mode == 0;
                tapped => { root.set-mode(root.cards[root.di].id, 0); } }
            if root.bit-set(root.cards[root.di].modes-mask, 2): Seg {
                label: "HEAT"; active: root.cards[root.di].mode == 1;
                tapped => { root.set-mode(root.cards[root.di].id, 1); } }
            if root.bit-set(root.cards[root.di].modes-mask, 4): Seg {
                label: "COOL"; active: root.cards[root.di].mode == 2;
                tapped => { root.set-mode(root.cards[root.di].id, 2); } }
            if root.bit-set(root.cards[root.di].modes-mask, 8): Seg {
                label: "AUTO"; active: root.cards[root.di].mode == 3;
                tapped => { root.set-mode(root.cards[root.di].id, 3); } }
            if root.bit-set(root.cards[root.di].modes-mask, 16): Seg {
                label: "FAN"; active: root.cards[root.di].mode == 4;
                tapped => { root.set-mode(root.cards[root.di].id, 4); } }
            if root.bit-set(root.cards[root.di].modes-mask, 32): Seg {
                label: "DRY"; active: root.cards[root.di].mode == 5;
                tapped => { root.set-mode(root.cards[root.di].id, 5); } }
        }
        // caption
        Text {
            x: (parent.width - self.width) / 2; y: 442px;
            text: "tap \u{2039} to go back \u{00b7} via Home Assistant";
            color: Theme.faint; font-size: 13px;
        }
    }
}
