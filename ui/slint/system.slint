import { Theme, StatRow, PageTitle } from "theme.slint";

export component SystemPage {
    // Chip AND panel on one row: this page is EXACTLY full at seven 48 px rows
    // (120 + 7*48 + 6*6 = 492 of 502 px), so `build-text` could only be added by
    // merging two static rows. Both halves are device constants that never
    // change, which makes them the cheapest thing on the page to combine.
    in property <string> chip-text: "ESP32-C6 \u{00b7} 410x502";
    in property <string> fw-text;      // "v0.12.1 · d8f228e" (version + git hash)
    in property <string> build-text;   // "Glowing Wright" (realm-sigil forge name)
    in property <string> sigil-text;   // "eldritch-lantern" (per-device sigil, #34)
    in property <string> heap-text;    // "123k free"
    in property <string> uptime-text;
    in property <string> battery-text; // "83% · 4012 mV"

    PageTitle { title: "SYSTEM"; }

    // Rows lifted and tightened so the last one clears the shell's page-dot
    // indicator. At y=120 with 6 px spacing the seventh row spanned 444-492 px and
    // its value text centred at ~468, landing squarely in the dots' band (they end
    // at y473) — "78 % - 4012 mV" rendered THROUGH the dots. Visible on shipped
    // firmware and invisible to every measurement, because item counts cannot see
    // overlap; it took rendering the page to a PPM to find it.
    //
    // 108 + 7*48 + 6*2 = 456, so the last row now centres at ~432 with 30 px of
    // clearance, and the title above still has 18 px.
    VerticalLayout {
        x: (parent.width - 330px) / 2;
        y: 108px;
        width: 330px;
        spacing: 2px;
        StatRow { label: "CHIP"; value: root.chip-text; }
        StatRow { label: "BUILD"; value: root.build-text; value-color: Theme.accent; }
        StatRow { label: "FIRMWARE"; value: root.fw-text; }
        StatRow { label: "SIGIL"; value: root.sigil-text; }
        StatRow { label: "HEAP"; value: root.heap-text; value-color: Theme.accent; }
        StatRow { label: "UPTIME"; value: root.uptime-text; }
        StatRow { label: "BATTERY"; value: root.battery-text; }
    }
}
