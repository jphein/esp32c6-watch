// Shared palette + small components for the watch shell.

// One mesh roster line. Lives here (not shell.slint) so both shell.slint and
// mesh.slint can import it without a recursive shell<->mesh import cycle.
export struct PeerRow {
    name: string,
    rssi: string,
    age: string,
}

// One discovered 802.15.4 PAN row for the Radio Scan screen (RS5). Mirrors
// PeerRow: every field pre-formatted by Rust (RS6 set_scan_pans) so the Slint
// side is pure layout.
export struct ScanRow {
    pan: string,       // "0x1234"
    channel: string,   // "ch 15"
    rssi: string,      // "-55 dBm" (last · ewma-smoothed feel)
    devices: string,   // "3 dev"
}

// One channel cell for the Radio Scan energy strip (16 channels, 11..26).
// `level`/`peak` are 0..1 bar fractions; Rust (RS6) normalises the raw frame
// count + peak RSSI from scan-model's ChannelStat into these.
export struct ScanChannel {
    level: float,      // activity bar height, 0..1
    peak: float,       // peak-hold marker height, 0..1
}

// One scanned WiFi network row for the Settings hub's NETWORK picker
// (v0.9.0). Rust dedups multi-AP SSIDs (keeping the best RSSI), sorts by
// strength, and maps RSSI onto the 0..4 `bars` buckets before pushing.
export struct WifiNet {
    ssid: string,
    bars: int,         // 0..4 signal-strength buckets
    secured: bool,     // any auth method (padlock glyph)
}

// One complete color scheme: 21 tokens. Field order mirrors the token roles —
// background → text tiers → brand → surfaces → state → one-off fills → pressed
// feedback. Exported so the Theme-picker overlay can render each scheme's OWN
// colors (Theme.palettes[i].*) independent of whichever scheme is active.
export struct Palette {
    bg: color,          // page/overlay opaque background
    scrim: color,       // translucent scrim over content (launcher)
    ink: color,         // primary text
    soft: color,        // secondary text
    dim: color,         // tertiary / labels
    faint: color,       // faintest text
    accent: color,      // primary brand
    accent2: color,     // secondary brand (gradient partner)
    panel: color,       // card/pill surface
    line: color,        // hairline border
    track: color,       // slider / progress track
    warn: color,        // error / danger
    warm: color,        // gold highlight (mid states)
    off-dot: color,     // inactive radio dot
    warn-bg: color,     // dark fill behind a warn control (reboot)
    warn-panel: color,  // warn card/panel
    accent-bg: color,   // tinted fill behind a primary/accent action
    on-accent: color,   // near-black ink/detail on a bright fill (btn text, eyes, pips)
    // Pressed-feedback fills (touch overhaul): swapped in on TouchArea.pressed —
    // ONE-FRAME state swaps, never animation loops (the sw renderer's full-frame
    // budget is ~90-170ms). Dark schemes press BRIGHTER, Paper presses DARKER.
    // The main recipes (controls.slint) use accent-bg / solid accent / solid
    // warn for their pressed states (design spec §5); these three are the
    // NEUTRAL/deep variants: `pressed` is the ghost-button held fill (scan
    // CANCEL); accent-/warn-pressed are reserved for held states on already-
    // tinted surfaces (e.g. a future long-press), where a full invert would
    // swamp adjacent content.
    pressed: color,        // held fill for neutral/ghost controls (rest = transparent/panel)
    accent-pressed: color, // held fill for accent surfaces (rest = accent-bg)
    warn-pressed: color,   // held fill for warn surfaces (rest = warn-bg)
}

export global Theme {
    // --- safe area (410x502 AMOLED with physically ROUNDED corners) ---
    // Centered content is corner-safe automatically; only elements that sit in
    // a corner get clipped by the arc. `safe-top`/`safe-bottom`/`safe-side` are
    // straight-edge insets; `safe-corner` is the extra side-inset for elements
    // that live IN a top corner (the status chrome), so they drop below and pull
    // in clear of the arc. Conservative values — good to a corner radius of
    // ~100px; revisit if the measured radius comes back larger. Geometry, not
    // palette — these never change with the scheme.
    out property <length> safe-top: 30px;
    out property <length> safe-bottom: 24px;
    out property <length> safe-side: 22px;
    out property <length> safe-corner: 30px;

    // Active scheme: 0 Midnight · 1 Paper · 2 Amber · 3 Violet. Written by the
    // Theme picker (instant preview) and by Rust (boot restore + persistence via
    // `ui.global::<Theme>().set_scheme(n)`). Rust clamps to 0..3 and it defaults
    // to 0, so `palettes[scheme]` is always in range. Every color token below is
    // rebound to the selected palette, so all 15 screens follow with no edits.
    in-out property <int> scheme: 0;

    // The four palettes. Contract: `accent` and `warm` stay bright enough in
    // every scheme that near-black `on-accent` reads on them (button text,
    // creature eyes, icon pips), so the on-accent usages need no per-call logic.
    out property <[Palette]> palettes: [
        // 0 — Midnight: current, refined. Teal on true-black (AMOLED-optimal).
        { bg: #000000, scrim: #05080af2, ink: #f2f5ff, soft: #9fb4d8, dim: #6b7794,
          faint: #55617a, accent: #35e0b0, accent2: #3a7bd5, panel: #101728, line: #2a3550,
          track: #16202f, warn: #ff5566, warm: #ffd166, off-dot: #223048, warn-bg: #200a10,
          warn-panel: #1a0a0e, accent-bg: #08201a, on-accent: #05100a,
          pressed: #1c2942, accent-pressed: #0f3a2e, warn-pressed: #38121c },
        // 1 — Paper: calm warm off-white (AMOLED-aware — not pure white).
        { bg: #eae7df, scrim: #d8d4c8ee, ink: #21252e, soft: #464e60, dim: #6d7486,
          faint: #a2a7b2, accent: #0e9e77, accent2: #2f6fca, panel: #f5f3ec, line: #d3cec1,
          track: #dcd7ca, warn: #cf3a49, warm: #c0851c, off-dot: #c7c2b5, warn-bg: #f7dfe1,
          warn-panel: #fbe6e8, accent-bg: #d3f0e6, on-accent: #0a1f16,
          pressed: #dedacc, accent-pressed: #b5e4d2, warn-pressed: #eec3c8 },
        // 2 — Amber: cozy sunset. Warm dark on true-black.
        { bg: #000000, scrim: #0a0602f2, ink: #fdf3e3, soft: #d8b48f, dim: #9c7c5e,
          faint: #6e5a45, accent: #ffb454, accent2: #ff7a3d, panel: #1c1409, line: #3a2c18,
          track: #201810, warn: #ff5566, warm: #ffd166, off-dot: #33261a, warn-bg: #200a10,
          warn-panel: #1a0a0e, accent-bg: #2a1b08, on-accent: #1a0f02,
          pressed: #2b2010, accent-pressed: #46300e, warn-pressed: #38121c },
        // 3 — Violet: nocturne. Cool indigo on true-black.
        { bg: #000000, scrim: #06060af2, ink: #f1eefc, soft: #bcb2e6, dim: #837aa8,
          faint: #5f5880, accent: #a78bfa, accent2: #6366f1, panel: #16121f, line: #2e2842,
          track: #1b1626, warn: #ff5d7a, warm: #ffd166, off-dot: #2a2440, warn-bg: #200a14,
          warn-panel: #1a0a10, accent-bg: #1a1330, on-accent: #0b0616,
          pressed: #221b31, accent-pressed: #2c2151, warn-pressed: #381226 },
    ];

    // Active palette — reactive: changing `scheme` re-evaluates this and every
    // token that reads from it, repainting all screens.
    property <Palette> p: palettes[scheme];

    out property <color> bg: p.bg;
    out property <color> scrim: p.scrim;
    out property <color> ink: p.ink;
    out property <color> soft: p.soft;
    out property <color> dim: p.dim;
    out property <color> faint: p.faint;
    out property <color> accent: p.accent;
    out property <color> accent2: p.accent2;
    out property <color> panel: p.panel;
    out property <color> line: p.line;
    out property <color> track: p.track;
    out property <color> warn: p.warn;
    out property <color> warm: p.warm;
    out property <color> off-dot: p.off-dot;
    out property <color> warn-bg: p.warn-bg;
    out property <color> warn-panel: p.warn-panel;
    out property <color> accent-bg: p.accent-bg;
    out property <color> on-accent: p.on-accent;
    out property <color> pressed: p.pressed;
    out property <color> accent-pressed: p.accent-pressed;
    out property <color> warn-pressed: p.warn-pressed;

    // --- type scale (design spec §7) ---
    // Named sizes so screens stop inventing their own. Weights/tracking stay at
    // the call site (Slint has no composite text style); the SIZE is the token.
    out property <length> t-display: 84px; // AOD & meter hero numerals
    // t-hero == t-display since the v0.9.0 ROM squeeze: every DISTINCT
    // font-size embeds a whole pre-rendered glyph set (~160KB at this size),
    // so the hero tier rides the display tier's glyphs. Don't split them
    // again without checking `espflash save-image` against the 4MB slot.
    out property <length> t-hero: 84px;    // current temp / dBFS heroes
    out property <length> t-title: 26px;   // PageTitle
    out property <length> t-value: 22px;   // StatRow values
    out property <length> t-body: 17px;    // tile labels, body copy
    out property <length> t-label: 14px;   // field labels, captions
    out property <length> t-caption: 13px; // honesty notes, hints

    // --- spacing scale (the de-facto grid, named) ---
    out property <length> sp1: 4px;
    out property <length> sp2: 8px;
    out property <length> sp3: 12px;
    out property <length> sp4: 16px;
    out property <length> sp5: 22px;
    out property <length> sp6: 30px;

    // --- radii ---
    out property <length> r-card: 16px;
    out property <length> r-chip: 12px;
}

// RadioDot and BackChevron (the interactive chrome) moved to controls.slint —
// the shared component library (design spec §5 / §10 Phase 0). theme.slint keeps
// only tokens + non-interactive helpers so controls.slint can import it without
// an import cycle.

// ===========================================================================
// CENTRING A Text: USE alignment, NOT `(parent.h - self.h) / 2`
// ===========================================================================
// Reading a Text's OWN intrinsic size — `self.height` or `self.width` — is the
// expensive part, and it is expensive for a non-obvious reason: that size is
// itself a computed binding, so each read drags in the chain that lays the
// paragraph out. Slint registers a dependency node per property read with no
// dedup (i-slint-core/properties.rs), 16 B each on riscv32.
//
// Reading `parent.height` is NOT the problem. Measured both ways on StatRow: a
// literal height and `height: parent.height` saved the SAME 268 nodes, so the
// whole cost was `self.height`.
//
//   y: (parent.height - self.height) / 2      // reads self.height
//   y: 0; height: parent.height;              // reads parent.height only
//   vertical-alignment: center;               // pixel-identical
//
// Prefer `height: parent.height` over a literal in a SHARED component: call
// sites override the height (power.slint gives StatRow 28px and 34px), and a
// literal silently de-centres them. That was caught by a byte-exact render
// compare, not by review.
//
// Measured cost of the idiom, per component, on this tree
// (tools/trackermeter/measure.sh, A/B via WATCH_UI_ROOT):
//
//   StatRow    23 instantiations   -268 nodes  -4,288 B   <- resident on EVERY frame
//   Seg        15                   -42          -672 B
//   Stepper     8                   -24          -384 B
//   PillButton 11                   -10          -160 B   marginal
//
// So: WRITE new centring the alignment way — it is free and identical. Do NOT
// sweep existing single-instance uses; one live instance costs ~32-128 B, which
// is not worth churning a working screen for. The cost scales with how many
// instances are LIVE AT ONCE, which is not the same as how many times the
// component is written (PillButton has more instantiations than Stepper and
// costs less), and is not decidable by grepping for `for` bodies — a component
// carrying the idiom multiplies wherever it is instantiated in a repeater.
//
// HORIZONTAL centring is NOT symmetric with vertical. `x: 0; width:
// parent.width; horizontal-alignment: center` shifts glyphs by ~1px whenever
// `letter-spacing` is set, because the trailing letter-space counts toward
// intrinsic width but not toward alignment. Twelve frames differed on Seg. Only
// convert the horizontal form where letter-spacing is unset, and verify with a
// render compare.

// One label/value line for stats-style pages.
export component StatRow {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.ink;
    width: 330px;
    height: 48px;

    Text {
        x: 0;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        color: Theme.dim;
        font-size: 16px;
        letter-spacing: 2px;
    }
    Text {
        x: parent.width - self.width;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.value;
        color: root.value-color;
        font-size: 22px;
        font-weight: 600;
    }
}

// Page title, centered at the top.
export component PageTitle {
    in property <string> title;
    x: 0; y: 0;
    width: 100%; height: 100%;
    Text {
        x: (parent.width - self.width) / 2;
        y: 56px;
        text: root.title;
        color: Theme.soft;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: 5px;
    }
}

