import { Theme } from "theme.slint";
import { IconButton, PillButton, BackChevron } from "controls.slint";

// Notification shade (#32): the top-edge swipe-DOWN overlay. Cards are built
// by Rust from the bounded notification ring (newest first, up to 4 visible;
// the footer says how many more are held). Interactions, routed in
// slint_shell::handle_touch + the card callbacks:
//   tap a card's X       → dismiss that one
//   swipe LEFT on a card → dismiss that one
//   CLEAR ALL pill       → empty the ring
//   swipe Up / Right / chevron → close (the shade slides back up)
// Card geometry is FIXED — Rust maps a dismiss-swipe's start_y back to a slot
// with the SHADE_CARD_* constants in slint_shell.rs; keep in sync.

// One notification card's display data (ages pre-formatted by Rust).
export struct NotifCard {
    source: int,   // glyph id — matches notify::Source
    title: string,
    body: string,
    age: string,
    present: bool,
}

// Per-source mini glyph, 28x28, drawn shapes only (no bitmap, no new font
// sizes — the ROM budget note in theme.slint applies). Ids = notify::Source.
component NotifGlyph {
    in property <int> id;
    in property <color> tint: Theme.accent;
    width: 28px;
    height: 28px;

    // 0 System: dot in a ring (the "status" mark).
    if root.id == 0: Rectangle {
        Rectangle { x: 3px; y: 3px; width: 22px; height: 22px; border-radius: 11px; border-width: 2px; border-color: root.tint; }
        Rectangle { x: 11px; y: 11px; width: 6px; height: 6px; border-radius: 3px; background: root.tint; }
    }
    // 1 Battery: low cell — outline + terminal + a thin red-zone fill.
    if root.id == 1: Rectangle {
        Rectangle { x: 2px; y: 8px; width: 20px; height: 13px; border-radius: 3px; border-width: 2px; border-color: root.tint; }
        Rectangle { x: 23px; y: 12px; width: 3px; height: 5px; border-radius: 1px; background: root.tint; }
        Rectangle { x: 5px; y: 11px; width: 4px; height: 7px; border-radius: 1px; background: Theme.warn; }
    }
    // 2 OTA / firmware: package tray + a block dropping in.
    if root.id == 2: Rectangle {
        Rectangle { x: 10px; y: 3px; width: 8px; height: 12px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 4px; y: 17px; width: 20px; height: 3px; border-radius: 1.5px; background: root.tint; }
        Rectangle { x: 4px; y: 20px; width: 3px; height: 5px; background: root.tint; }
        Rectangle { x: 21px; y: 20px; width: 3px; height: 5px; background: root.tint; }
    }
    // 3 WiFi: ascending signal bars (the picker idiom).
    if root.id == 3: Rectangle {
        Rectangle { x: 3px; y: 17px; width: 5px; height: 8px; border-radius: 1px; background: root.tint; }
        Rectangle { x: 11px; y: 11px; width: 5px; height: 14px; border-radius: 1px; background: root.tint.with-alpha(0.7); }
        Rectangle { x: 19px; y: 4px; width: 5px; height: 21px; border-radius: 1px; background: root.tint.with-alpha(0.45); }
    }
    // 4 Home Assistant / MQTT: a bell — dome + base bar + clapper.
    if root.id == 4: Rectangle {
        Rectangle { x: 7px; y: 4px; width: 14px; height: 15px; border-radius: 7px; background: root.tint; }
        Rectangle { x: 7px; y: 13px; width: 14px; height: 6px; background: root.tint; }
        Rectangle { x: 4px; y: 19px; width: 20px; height: 3px; border-radius: 1.5px; background: root.tint; }
        Rectangle { x: 12px; y: 23px; width: 4px; height: 4px; border-radius: 2px; background: root.tint.with-alpha(0.7); }
    }
}

export component ShadeOverlay {
    // 4 fixed card slots, padded with present:false (launcher-grid idiom).
    in property <[NotifCard]> cards: [];
    // Total held in the ring (may exceed the 4 visible).
    in property <int> total: 0;
    callback dismiss(int); // card slot (== ring index, newest = 0)
    callback clear-all();
    callback close();

    Rectangle { width: 100%; height: 100%; background: Theme.scrim; }

    Text {
        x: (parent.width - self.width) / 2;
        y: 36px;
        text: "NOTIFICATIONS";
        color: Theme.faint;
        font-size: 12px;
        letter-spacing: 3px;
    }
    BackChevron { clicked => { root.close(); } }

    // Empty state.
    if root.total == 0: Text {
        x: (parent.width - self.width) / 2;
        y: 230px;
        text: "All clear";
        color: Theme.dim;
        font-size: Theme.t-body;
    }
    if root.total == 0: Text {
        x: (parent.width - self.width) / 2;
        y: 262px;
        text: "alerts and HA messages land here";
        color: Theme.faint;
        font-size: Theme.t-caption;
    }

    // Notification cards — fixed slots (y = 76 + i*92, h 84; see the
    // SHADE_CARD_* constants in slint_shell.rs). Panel surface, glyph left,
    // dismiss X right (44px target, Recipe B halo).
    for i in 4: Rectangle {
        x: 27px;
        y: 76px + i * 92px;
        width: 356px;
        height: 84px;
        if root.cards[i].present: Rectangle {
            width: 100%; height: 100%;
            border-radius: Theme.r-card;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            NotifGlyph {
                x: 16px;
                y: 16px;
                id: root.cards[i].source;
            }
            Text {
                x: 58px;
                y: 13px;
                width: parent.width - 118px;
                overflow: elide;
                text: root.cards[i].title;
                color: Theme.ink;
                font-size: Theme.t-body;
                font-weight: 600;
            }
            Text {
                x: 58px;
                y: 38px;
                width: parent.width - 118px;
                height: 38px;
                overflow: elide;
                wrap: word-wrap;
                text: root.cards[i].body;
                color: Theme.soft;
                font-size: Theme.t-label;
            }
            Text {
                x: parent.width - self.width - 16px;
                y: 58px;
                text: root.cards[i].age;
                color: Theme.faint;
                font-size: Theme.t-caption;
            }
            x-btn := IconButton {
                x: parent.width - self.width - 4px;
                y: 4px;
                width: 44px;
                height: 44px;
                clicked => { root.dismiss(i); }
                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "x";
                    color: x-btn.pressed ? Theme.accent : Theme.dim;
                    font-size: 17px;
                    font-weight: 600;
                }
            }
        }
    }

    // Footer: CLEAR ALL (Recipe D pill) + overflow honesty.
    if root.total > 0: PillButton {
        x: (parent.width - self.width) / 2;
        y: 446px;
        width: 150px;
        height: 40px;
        text: "CLEAR ALL";
        text-size: 14px;
        clicked => { root.clear-all(); }
    }
    if root.total > 4: Text {
        x: 320px;
        y: 457px;
        text: "+\{root.total - 4}";
        color: Theme.faint;
        font-size: Theme.t-caption;
    }
}
