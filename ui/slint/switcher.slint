import { Theme, PageTitle } from "theme.slint";
import { PressTile, BackChevron } from "controls.slint";
import { LauncherTile, AppIcon } from "launcher.slint";

// App switcher (#31): the bottom-edge-HOLD overlay — alt-tab for the watch.
// One card per suspended session (most recently suspended first), built by
// Rust from the app registry and pushed as `LauncherTile`s (same struct as the
// launcher grid — glyph + name + accent + registry idx; `present:false` pads
// the fixed 4 slots). Interactions, routed in slint_shell::handle_touch:
//   tap a card         → resume (fb apps re-alloc the fb, KEEP their state)
//   swipe UP on a card → kill (state dropped; next open runs setup())
//   swipe Right/Down / chevron → close
// Card geometry is FIXED (top/height/gap) — Rust maps a kill-swipe's start_y
// back to a slot with the CARD_* constants in slint_shell.rs; keep in sync.

export component SwitcherOverlay {
    // 4 fixed slots, padded with present:false (launcher-grid idiom).
    in property <[LauncherTile]> tiles: [];
    // Suspended-session count (may exceed the 4 visible slots).
    in property <int> count: 0;
    callback resume(int); // registry idx → same launch path as a tile tap
    callback close();

    Rectangle { width: 100%; height: 100%; background: Theme.scrim; }

    Text {
        x: (parent.width - self.width) / 2;
        y: 36px;
        text: "SWITCHER";
        color: Theme.faint;
        font-size: 12px;
        letter-spacing: 3px;
    }
    PageTitle { title: "SESSIONS"; }
    BackChevron { clicked => { root.close(); } }

    // Empty state: honest about what earns a card.
    if root.count == 0: Text {
        x: (parent.width - self.width) / 2;
        y: 230px;
        text: "Nothing suspended";
        color: Theme.dim;
        font-size: Theme.t-body;
    }
    if root.count == 0: Text {
        x: (parent.width - self.width) / 2;
        y: 262px;
        text: "leave a game with the side button";
        color: Theme.faint;
        font-size: Theme.t-caption;
    }

    // Session cards — fixed slots (y = 110 + i*96, h 84; see slint_shell.rs
    // SWITCHER_CARD_* constants). PressTile (Recipe A): fill lights to
    // accent-bg + edge ignites in the app's own accent on finger-down.
    for i in 4: Rectangle {
        x: 35px;
        y: 110px + i * 96px;
        width: 340px;
        height: 84px;
        if root.tiles[i].present: PressTile {
            width: 100%; height: 100%;
            ignite: root.tiles[i].accent;
            clicked => { root.resume(root.tiles[i].idx); }
            AppIcon {
                x: 20px;
                y: (parent.height - self.height) / 2;
                id: root.tiles[i].icon-id;
                tint: root.tiles[i].accent;
            }
            Text {
                x: 86px;
                y: 18px;
                width: parent.width - 100px;
                overflow: elide;
                text: root.tiles[i].name;
                color: Theme.ink;
                font-size: Theme.t-body;
                font-weight: 600;
            }
            Text {
                x: 86px;
                y: 46px;
                text: "PAUSED";
                color: Theme.faint;
                font-size: Theme.t-caption;
                letter-spacing: 2px;
            }
        }
    }

    // Overflow honesty + the gesture legend.
    if root.count > 4: Text {
        x: (parent.width - self.width) / 2;
        y: 452px;
        text: "+\{root.count - 4} more";
        color: Theme.faint;
        font-size: Theme.t-caption;
    }
    if root.count > 0 && root.count <= 4: Text {
        x: (parent.width - self.width) / 2;
        y: 452px;
        text: "TAP RESUME \u{00b7} SWIPE UP KILL";
        color: Theme.faint;
        font-size: Theme.t-caption;
        letter-spacing: 1px;
    }
}
