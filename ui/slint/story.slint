import { Theme, PageTitle, StatRow } from "theme.slint";
import { OverlaySwallow, BackChevron, PressTile, Seg } from "controls.slint";

// Endless LitRPG reader (#story) — four pages behind one overlay registration:
//
//   0 LIST      chapter index from /api/chapters
//   1 PLAY      streaming playback with a live "who is speaking" chip
//   2 STATS     level / XP / HP / gold / location, from /api/character
//   3 CHARACTER the 6 appear:* traits and 11 equip:* slots, same payload
//
// Design spec: ~/Projects/endlesslitrpg/docs/superpowers/specs/2026-07-29-endless-litrpg-design.md
// §9.4 (the watch app) and §9.4.1 (these two extra pages).
//
// ===========================================================================
// THE ONE LAYOUT RULE THAT IS LOAD-BEARING, NOT COSMETIC
// ===========================================================================
// On the PLAY page every element that changes during playback has **fixed
// geometry**: same rect, same position, every frame. Only glyphs and one fill
// width change inside them.
//
// This is not tidiness. A full-frame Slint paint on this panel is 90-170 ms
// (main.rs:1726, measured), while the audio DMA ring holds only 48 ms and
// nothing refills it while a paint blocks the single-threaded executor. Partial
// rendering is on (RepaintBufferType::ReusedBuffer), so the paint cost scales
// with the DIRTY REGION — and a region only stays small if nothing moves or
// reflows. A scrolling read-along view, a chip that resizes to its text, or a
// time label that shifts as digits change would each dirty far more than the
// band they occupy and blow the budget.
//
// So: the three changing elements are stacked into one contiguous band, each in
// a fixed-size box with centred content. `net::story_play::PaintGate` measures
// the result and switches highlighting off if it ever exceeds 30 ms — see
// `highlight-off` below, which is how that becomes visible instead of silent.
//
// Everything uses Theme.* tokens only, so all four palettes (including the light
// `Paper` scheme) work with no per-screen edits.

// One row of the chapter index. Capped to what the list actually draws — #75's
// lesson is that the apps-menu OOM was a DRAWN-ITEM-COUNT problem, so this list
// pages through a small window rather than instantiating every chapter.
export struct StoryChapter {
    number: int,
    title: string,
    duration: string,
    playable: bool,
    current: bool,
}

// A label/value pair: an inventory line, an equipment slot, an appearance trait.
export struct StorySlot {
    label: string,
    value: string,
    known: bool,
}

export component StoryPage {
    // ---- navigation ----
    in property <int> page: 0;
    callback close();
    callback nav(int);

    // ---- LIST ----
    in property <[StoryChapter]> chapters;
    in property <bool> loading: false;
    in property <string> error-text;
    // Chapters the cap could not hold, so "showing 24 of 60" is honest rather
    // than a silent truncation.
    in property <int> more-count: 0;
    callback pick(int);
    callback page-prev();
    callback page-next();

    // ---- PLAY ----
    in property <string> play-title;
    // Speaker name for the current segment ("Sera", "SYSTEM", "Narrator").
    in property <string> speaker;
    // 0 narrator · 1 system · 2 dialogue · 3 unknown — tints the chip.
    in property <int> speaker-kind: 0;
    in property <float> progress: 0.0;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    in property <int> seg-index: 0;
    in property <int> seg-count: 0;
    in property <bool> playing: false;
    // The manifest could not be trusted (over the cap, non-contiguous, or a rate
    // this hardware cannot play), so there is no speaker chip. Playback is
    // unaffected — see SegmentIndex::usable.
    in property <bool> no-manifest: false;
    // PaintGate tripped: highlighting was switched off mid-chapter to protect the
    // audio. Shown, because a feature that stops silently is a bug report later.
    in property <bool> highlight-off: false;
    callback stop();
    callback pause();
    callback resume();
    // True when a chapter was paused and can be resumed. Separate from `playing`
    // because the three states are distinct on screen: playing shows PAUSE, paused shows
    // RESUME with the elapsed time HELD, and neither shows the "tap a chapter" hint.
    in property <bool> paused: false;

    // ---- STATS / CHARACTER ----
    in property <string> subject;
    in property <string> level: "—";
    in property <string> xp: "—";
    in property <string> gold: "—";
    in property <string> location: "—";
    in property <string> status;
    in property <string> hp-text: "—";
    in property <float> hp-frac: 0.0;
    // HP 0 and HP unknown are very different things to show a reader, so the bar
    // is SUPPRESSED when unknown rather than drawn empty.
    in property <bool> hp-known: false;
    in property <[StorySlot]> equipment;
    in property <[StorySlot]> appearance;
    in property <int> equipped-count: 0;
    in property <int> appearance-count: 0;
    // Director note by voice (push-to-talk → STT → POST /api/notes).
    callback note();

    // ---- fixed geometry for the CHARACTER page (page 3) --------------------
    // A literal, so every expression built from it is constant-folded and emits no
    // binding at all. Swapping these three uses back to
    // `root.width - 2 * Theme.safe-side` was measured: +6 allocations and +336 B
    // on the host harness, and — worth knowing before optimising the wrong thing —
    // ZERO change in dependency-node count, because `root.width` is itself
    // compile-time constant on a fixed-size window, and a constant property is
    // marked with `const_sentinel()` so reading it never registers a dependency
    // (i-slint-core/properties.rs). The saving is one binding holder per row, not
    // a dependency node per read.
    //
    // Affordable here only because the panel is a 410x502 AMOLED that never
    // resizes, so the arithmetic is a fact rather than a measurement. Named rather
    // than scattered so it stays auditable: if the panel changes, this is the edit.
    property <length> content-w: 366px; // 410 - 2 * Theme.safe-side(22)

    Rectangle { width: 100%; height: 100%; background: Theme.bg; }
    OverlaySwallow {} // #54: chrome beneath must never be hit-testable

    PageTitle {
        title: root.page == 0 ? "STORY"
             : root.page == 1 ? "READING"
             : root.page == 2 ? "STATS" : "CHARACTER";
    }
    BackChevron { clicked => { root.close(); } }

    // ==================== page tabs ====================
    // Fixed row, always present, so switching pages never reflows the chrome.
    HorizontalLayout {
        x: Theme.safe-side;
        y: 96px;
        width: root.width - 2 * Theme.safe-side;
        height: 34px;
        spacing: 6px;
        Seg { label: "LIST";  active: root.page == 0; tapped => { root.nav(0); } }
        Seg { label: "READ";  active: root.page == 1; tapped => { root.nav(1); } }
        Seg { label: "STATS"; active: root.page == 2; tapped => { root.nav(2); } }
        Seg { label: "CHAR";  active: root.page == 3; tapped => { root.nav(3); } }
    }

    // ==================== 0 — chapter list ====================
    if root.page == 0 && root.loading: Text {
        x: (parent.width - self.width) / 2;
        y: 240px;
        text: "Loading\u{2026}";
        color: Theme.dim;
        font-size: 20px;
    }

    if root.page == 0 && root.error-text != "": Text {
        x: (parent.width - self.width) / 2;
        y: 240px;
        width: root.width - 2 * Theme.safe-side;
        horizontal-alignment: center;
        wrap: word-wrap;
        text: root.error-text;
        color: Theme.warn;
        font-size: 18px;
    }

    if root.page == 0 && !root.loading && root.error-text == "": VerticalLayout {
        x: Theme.safe-side;
        y: 144px;
        width: root.width - 2 * Theme.safe-side;
        spacing: 5px;

        // Five rows at 50 px ends at 414, clear of the "+N more" line and the
        // pager below. Rust pushes at most VISIBLE_CHAPTERS, so this layout and
        // that constant must move together.
        for ch[i] in root.chapters: PressTile {
            height: 50px;
            enabled: ch.playable;
            rest-background: ch.current ? Theme.accent-bg : Theme.panel;
            clicked => { root.pick(ch.number); }

            // Chapter number, fixed-width gutter so titles align.
            Text {
                x: 12px;
                y: (parent.height - self.height) / 2;
                width: 34px;
                horizontal-alignment: right;
                text: ch.number;
                color: ch.current ? Theme.accent : Theme.dim;
                font-size: 18px;
                font-weight: 600;
            }
            Text {
                x: 56px;
                y: 8px;
                width: parent.width - 56px - 74px;
                text: ch.title;
                color: ch.playable ? Theme.ink : Theme.faint;
                font-size: 17px;
                overflow: elide;
            }
            Text {
                x: 56px;
                y: 29px;
                text: ch.duration;
                color: Theme.dim;
                font-size: 14px;
            }
            // Audio dot: filled when there is PCM to stream, hollow when the
            // chapter exists as text only.
            Rectangle {
                x: parent.width - 26px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: ch.playable ? Theme.accent : Theme.bg;
                border-width: ch.playable ? 0px : 1px;
                border-color: Theme.line;
            }
        }
    }

    // Paging + the honest overflow count.
    if root.page == 0 && root.chapters.length > 0: HorizontalLayout {
        x: Theme.safe-side;
        y: root.height - Theme.safe-bottom - 40px;
        width: root.width - 2 * Theme.safe-side;
        height: 34px;
        spacing: 8px;
        // 438..472 — inside the 478 px safe area.
        Seg { label: "\u{2039} NEWER"; tapped => { root.page-prev(); } }
        Seg { label: "OLDER \u{203a}"; tapped => { root.page-next(); } }
    }
    if root.page == 0 && root.more-count > 0: Text {
        x: (parent.width - self.width) / 2;
        y: 418px;
        text: "+" + root.more-count + " more";
        color: Theme.faint;
        font-size: 13px;
    }

    // ==================== 1 — playback ====================
    // Chapter title: STATIC during playback, so it is kept well clear of the
    // changing band below.
    if root.page == 1: Text {
        x: Theme.safe-side;
        y: 152px;
        width: root.width - 2 * Theme.safe-side;
        horizontal-alignment: center;
        text: root.play-title;
        color: Theme.ink;
        font-size: 19px;
        overflow: elide;
    }

    // ---- the changing band: one contiguous region, fixed geometry ----------
    // Speaker chip. FIXED 260x44 regardless of the name inside it — a chip that
    // resized to its text would dirty a different rect on every segment and
    // defeat the partial-render budget.
    if root.page == 1 && !root.no-manifest: Rectangle {
        x: (root.width - 260px) / 2;
        y: 214px;
        width: 260px;
        height: 44px;
        border-radius: 22px;
        background: root.speaker-kind == 1 ? Theme.track : Theme.accent-bg;
        border-width: 1px;
        border-color: root.speaker-kind == 1 ? Theme.line : Theme.accent;
        clip: true;

        // The text changes EVERY SEGMENT, so its intrinsic size recomputes on every
        // repaint of the hot band — and reading a Text's own size drags in the
        // paragraph-layout binding chain (the centring-audit finding, measured at
        // -268 nodes on StatRow). `worst_us` sits at 26-30 ms of a 30 ms budget with
        // one gate trip on glass, so this path has no slack for computed centring.
        //
        // Vertical: full-height + vertical-alignment, proven PIXEL-IDENTICAL by the
        // audit. Horizontal stays the intrinsic read: letter-spacing is set here,
        // and the audit measured that trailing letter-space counts toward intrinsic
        // width but not toward alignment — switching methods shifts glyphs ~1px.
        Text {
            x: (parent.width - self.width) / 2;
            height: parent.height;
            vertical-alignment: center;
            text: root.speaker;
            color: root.speaker-kind == 1 ? Theme.soft : Theme.accent;
            font-size: 19px;
            font-weight: 600;
            letter-spacing: root.speaker-kind == 1 ? 3px : 1px;
            overflow: elide;
        }
    }
    // No trustworthy manifest: say so rather than showing a blank chip.
    if root.page == 1 && root.no-manifest: Text {
        x: (parent.width - self.width) / 2;
        y: 226px;
        text: "no segment data";
        color: Theme.faint;
        font-size: 15px;
    }

    // Progress track: fixed rect; only the fill's width changes.
    if root.page == 1: Rectangle {
        x: Theme.safe-side;
        y: 282px;
        width: root.width - 2 * Theme.safe-side;
        height: 8px;
        border-radius: 4px;
        background: Theme.track;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * clamp(root.progress, 0.0, 1.0);
            height: parent.height;
            border-radius: 4px;
            background: Theme.accent;
        }
    }

    // Times: fixed-width boxes with fixed alignment, so a digit change never
    // shifts anything.
    if root.page == 1: Text {
        x: Theme.safe-side;
        y: 300px;
        width: 90px;
        horizontal-alignment: left;
        text: root.elapsed;
        color: Theme.soft;
        font-size: 15px;
    }
    if root.page == 1: Text {
        x: root.width - Theme.safe-side - 90px;
        y: 300px;
        width: 90px;
        horizontal-alignment: right;
        text: root.total;
        color: Theme.dim;
        font-size: 15px;
    }
    // Same hot-band rule as the chip: this text changes every segment. No
    // letter-spacing, so alignment-based centring is safe on this one (the ~1px
    // shift the audit measured only occurs where letter-spacing is set). The
    // full-width rect does not enlarge the band's dirty region — the progress bar
    // above it already spans the same width.
    if root.page == 1 && root.seg-count > 0: Text {
        x: Theme.safe-side;
        width: root.width - 2 * Theme.safe-side;
        horizontal-alignment: center;
        y: 300px;
        text: root.seg-index + " / " + root.seg-count;
        color: Theme.faint;
        font-size: 14px;
    }
    // ---- end of the changing band -----------------------------------------

    // Highlighting was switched off to protect the audio. Visible on purpose:
    // a cosmetic feature that stops without saying so becomes a bug report.
    if root.page == 1 && root.highlight-off: Text {
        x: (parent.width - self.width) / 2;
        y: 336px;
        text: "highlighting paused (audio priority)";
        color: Theme.faint;
        font-size: 13px;
    }

    // Stop: the escape hatch. Playback parks the main loop for up to 18 minutes,
    // and JP has been chasing "the watch is frozen" reports that were really
    // responsive firmware behind a stuck-looking UI. A visible stop turns
    // "it's frozen" into "I stopped it" — painted BEFORE audio starts, never
    // during.
    // Two tiles side by side while playing: PAUSE (accent) and STOP (warn). Sized 176px
    // each with a 14px gutter inside the 366px safe width, so both stay well over the
    // 44px minimum touch target in both axes and neither can be hit by accident when
    // aiming for the other.
    if root.page == 1 && root.playing: PressTile {
        x: Theme.safe-side;
        y: 378px;
        width: 176px;
        height: 60px;
        ignite: Theme.accent;
        clicked => { root.pause(); }

        Text {
            x: (parent.width - self.width) / 2;
            y: 18px;
            text: "PAUSE";
            color: Theme.accent;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 3px;
        }
    }
    if root.page == 1 && root.playing: PressTile {
        x: root.width - Theme.safe-side - 176px;
        y: 378px;
        width: 176px;
        height: 60px;
        ignite: Theme.warn;
        clicked => { root.stop(); }

        Text {
            x: (parent.width - self.width) / 2;
            y: 18px;
            text: "STOP";
            color: Theme.warn;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 3px;
        }
    }

    // Paused: RESUME takes the full width, because there is nothing to STOP — the stream
    // is already closed and the position is just a number we are holding. A STOP here
    // would only mean "forget where I was", which the LIST tab already does.
    if root.page == 1 && root.paused && !root.playing: PressTile {
        x: Theme.safe-side;
        y: 378px;
        width: root.width - 2 * Theme.safe-side;
        height: 60px;
        ignite: Theme.accent;
        clicked => { root.resume(); }

        Text {
            x: (parent.width - self.width) / 2;
            y: 18px;
            text: "RESUME";
            color: Theme.accent;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 3px;
        }
    }
    if root.page == 1 && !root.playing && !root.paused: Text {
        x: (parent.width - self.width) / 2;
        y: 396px;
        text: "tap a chapter in LIST to play";
        color: Theme.dim;
        font-size: 16px;
    }

    // ==================== 2 — stats ====================
    if root.page == 2: VerticalLayout {
        x: (root.width - 330px) / 2;
        y: 140px;
        width: 330px;
        spacing: 0px;

        Text {
            text: root.subject;
            color: Theme.accent;
            font-size: 20px;
            font-weight: 600;
            height: 32px;
        }

        // HP bar — SUPPRESSED when hp is unknown. The live ledger has hp: null
        // against max_hp: 110, and a bar drawn at zero would assert the
        // protagonist is dead.
        Rectangle {
            height: 46px;
            Text {
                x: 0;
                y: 0;
                text: "HP";
                color: Theme.dim;
                font-size: 16px;
                letter-spacing: 2px;
            }
            Text {
                x: parent.width - self.width;
                y: 0;
                text: root.hp-text;
                color: root.hp-known ? Theme.ink : Theme.faint;
                font-size: 20px;
                font-weight: 600;
            }
            if root.hp-known: Rectangle {
                x: 0;
                y: 28px;
                width: parent.width;
                height: 10px;
                border-radius: 5px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width * clamp(root.hp-frac, 0.0, 1.0);
                    height: parent.height;
                    border-radius: 5px;
                    background: root.hp-frac < 0.25 ? Theme.warn : Theme.accent;
                }
            }
            // Unknown: a dashed-looking empty track reads as "no data", which is
            // deliberately different from a zero-width fill on a live track.
            if !root.hp-known: Rectangle {
                x: 0;
                y: 28px;
                width: parent.width;
                height: 10px;
                border-radius: 5px;
                background: Theme.bg;
                border-width: 1px;
                border-color: Theme.line;
            }
        }

        StatRow { label: "LEVEL"; value: root.level; }
        StatRow { label: "XP"; value: root.xp; }
        StatRow {
            label: "GOLD";
            value: root.gold;
            value-color: root.gold == "—" ? Theme.faint : Theme.warm;
        }
        StatRow { label: "LOCATION"; value: root.location; }
    }
    // Single elided line at 414..434, below the stats block (ends 410) and above
    // the button (438). Word-wrap here would grow to two lines and overdraw the
    // button — the collision that put the original at y=404, inside the last
    // StatRow.
    if root.page == 2 && root.status != "": Text {
        x: Theme.safe-side;
        y: 414px;
        width: root.width - 2 * Theme.safe-side;
        height: 20px;
        horizontal-alignment: center;
        overflow: elide;
        text: root.status;
        color: Theme.soft;
        font-size: 15px;
    }

    // Director note by voice — reuses the existing push-to-talk STT path.
    if root.page == 2: PressTile {
        x: (root.width - 200px) / 2;
        y: 438px;
        width: 200px;
        height: 36px;
        clicked => { root.note(); }
        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "DIRECTOR NOTE";
            color: Theme.soft;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 2px;
        }
    }

    // ==================== 3 — character ====================
    // Text-and-icon panel, NOT a composited portrait: a 410x502 RGB565 frame is
    // ~412 KB against 512 KB of SRAM with no PSRAM, and the layered art does not
    // exist. Reserved as Phase 2b (design §9.4.1).
    //
    // ===========================================================================
    // WHY THIS PAGE SHOWS SIX ROWS AT A TIME AND NOT SEVENTEEN
    // ===========================================================================
    // Rendering all 17 slots at once is not a heavy screen, it is a REBOOT. Two of
    // two hardware trials: populate every slot, tap CHAR, and the watch resets
    // (`up=` 63s -> 17s, pools back at boot rungs, app back to Watchface).
    //
    // The mechanism is a doubling rung, not a slow leak. `PrepareScene` emits one
    // scene item AND one texture per rendered GLYPH, and its vectors grow by
    // powers of two, so crossing 256 textures asks esp-alloc for
    // 512 x 28 = 14,336 B **contiguous**. `maxblk_main` is 0 — main cannot serve
    // any block at all — so the request falls to the reclaimed pool, whose free
    // bytes are a sum of holes. 23,748 B free with no single 14,336 B hole fails
    // outright, and it fails during the tap, before a heartbeat can report a floor.
    //
    // So the budget is a hard count, and it was measured, not guessed
    // (tools/lunameter/measure.sh, all 17 rows rendered):
    //
    //   fixed floor (tabs + title + chevron + 93 label glyphs)  =  149 items
    //   ...which leaves 107 items for SEVENTEEN values:
    //     6-char values -> 251 items   cap 256   (the last safe width)
    //     7-char values -> 268 items   cap 512   CROSSED
    //
    // Six characters. The daemon's own naming style runs 22-28
    // ("Shard of Divine Foundation"), so there is no value width that is both
    // legible and safe while 17 rows paint. This page could not be tuned; only
    // reshaped. Predicted counts matched the four measured arms to within 1 item,
    // which is why the redesign was chosen over another round of trimming.
    //
    // ONE SECTION AT A TIME, six single-column rows. Worst window measures well
    // inside cap 256 and tolerates 28-glyph values before it would cross — so the
    // rung now has margin against the daemon's real naming width, not 11 glyphs of
    // it. The single wide column also FIXES a display bug the two-column grid had:
    // 111 px of value column elided a 24-character name to about thirteen
    // characters, so the reader never saw the name they were being shown.
    //
    // Every slot stays reachable — that is the point of the view switcher. The
    // previous single-column attempt ran 11 rows from y=344 to 596px on a 502px
    // panel and put `main_hand`, `off_hand`, `ring1` and `ring2` entirely
    // off-glass; the two-column grid fixed the reachability and hit the rung
    // instead. A window fixes both.
    //
    // The empty state still reads as "no data yet" and not as "broken": every
    // view renders its full complement of seeded em-dash rows, and the `known`
    // counters stay on screen, so 0/11 with eleven dashes across two GEAR views is
    // as unambiguous as eleven dashes in one grid was.

    // Which slice of the character sheet is on screen: 0 appearance · 1 equipment
    // 1-6 · 2 equipment 7-11. Local UI state — Rust neither sets nor needs it, so
    // it stays out of the shell's property surface.
    property <int> char-view: 0;
    // Which half of the 11 equipment slots view 1/2 shows. Compared against
    // `floor(i / 6)` per row, which is ONE read of the loop index instead of the
    // two an `i >= start && i < start + 6` pair would take.
    property <int> gear-page: root.char-view == 2 ? 1 : 0;

    // View switcher. Replaces the two static section headers rather than adding to
    // them, so the glyphs it costs are glyphs the headers gave back.
    if root.page == 3: HorizontalLayout {
        x: Theme.safe-side;
        y: 138px;
        width: root.content-w;
        height: 30px;
        spacing: 6px;
        Seg { label: "APPEAR";  active: root.char-view == 0; tapped => { root.char-view = 0; } }
        Seg { label: "GEAR I";  active: root.char-view == 1; tapped => { root.char-view = 1; } }
        Seg { label: "GEAR II"; active: root.char-view == 2; tapped => { root.char-view = 2; } }
    }

    // The six appearance traits — all of them, so this view needs no window.
    if root.page == 3 && root.char-view == 0: Rectangle {
        x: Theme.safe-side;
        y: 182px;
        width: root.content-w;
        height: 240px; // 6 rows x 40px — ends at 422, clear of the count line
        for tr[i] in root.appearance: Rectangle {
            x: 0;
            y: i * 40px;
            width: root.content-w;
            height: 40px;
            // Centred by a LITERAL box height plus vertical-alignment, never by
            // `(parent.height - self.height) / 2` — that reads two live properties,
            // so on a repeated row it is two more 16 B dependency nodes per Text,
            // per row, for a result that is identical on a fixed 30 px row.
            Text {
                x: 0;
                y: 0;
                height: 40px;
                vertical-alignment: center;
                text: tr.label;
                color: Theme.dim;
                font-size: 14px;
            }
            Text {
                x: 108px;
                y: 0;
                height: 40px;
                vertical-alignment: center;
                width: root.content-w - 108px;
                text: tr.known ? tr.value : "—";
                color: tr.known ? Theme.ink : Theme.faint;
                font-size: 15px;
                overflow: elide;
            }
        }
    }

    // Equipment, windowed. The repeater still walks all eleven slots — one array
    // stays the source of truth — but a row outside the current window renders NO
    // Text children, and a glyph that is never emitted is never a scene item. This
    // is the launcher's padded-slot result (AUDIO: 35 items with 7 padded slots),
    // applied to a model instead of a page grid.
    if root.page == 3 && root.char-view != 0: Rectangle {
        x: Theme.safe-side;
        y: 182px;
        width: root.content-w;
        height: 240px;
        for sl[i] in root.equipment: Rectangle {
            x: 0;
            // mod()/floor() rather than `i < 6 ? i : i - 6`. Slint does not dedup
            // dependency registrations — `register_as_dependency_to_current_binding`
            // allocates unconditionally per read — so re-reading the loop index in
            // the same expression allocates again. A/B measured on these 11 rows:
            // the conditional form costs +22 nodes, 352 B on the device, for an
            // identical result.
            y: mod(i, 6) * 40px;
            width: root.content-w;
            height: 40px;
            if floor(i / 6) == root.gear-page: Rectangle {
                Text {
                    x: 0;
                    y: 0;
                    height: 40px;
                    vertical-alignment: center;
                    text: sl.label;
                    color: Theme.dim;
                    font-size: 14px;
                }
                Text {
                    x: 108px;
                    y: 0;
                    height: 40px;
                    vertical-alignment: center;
                    width: root.content-w - 108px;
                    text: sl.known ? sl.value : "—";
                    color: sl.known ? Theme.ink : Theme.faint;
                    font-size: 15px;
                    overflow: elide;
                }
            }
        }
    }

    // How much of the sheet the ledger has actually filled. Kept visible in every
    // view: it is the difference between "the fetch returned nothing" and "this
    // character genuinely wears nothing", which em-dashes alone cannot say.
    if root.page == 3: Text {
        x: Theme.safe-side;
        y: 434px;
        width: root.content-w;
        horizontal-alignment: center;
        text: root.char-view == 0
            ? root.appearance-count + "/6 traits known"
            : root.equipped-count + "/11 slots known";
        color: Theme.faint;
        font-size: 13px;
    }
}
