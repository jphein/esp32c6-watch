import { Theme, PageTitle } from "theme.slint";
import { OverlaySwallow, PressTile, IconButton } from "controls.slint";

// Categorised PAGED launcher with drawn vector icons + big finger tiles. Icons
// are lightweight Slint shapes (no bitmaps) so they cost no RAM/flash and
// render crisp on the RGB565 sw renderer.
//
// PAGED, not scrolled: the old Flickable's continuous scroll dirtied the whole
// viewport every frame → ~100ms full-frame renders → a 6-10fps scroll that no
// library can save on this sw renderer. Instead the launcher is SCREENFULS: a
// 3x3 tile grid per page, one page per registry section (AUDIO / GAMES /
// SYSTEM — a section >9 apps would chunk into repeated pages), swipe up/down
// flips exactly ONE page (handled in slint_shell::handle_touch, same place the
// old scroll swipes were routed) as a single hard-cut full-frame render —
// instant, no intermediate frames. Right-swipe still closes.
//
// The tile content is DATA-DRIVEN: Rust (build_launcher_pages) flattens the
// REGISTRY (src/apps/registry.rs, the single source of truth) into `tiles` —
// page-count × 9 entries, each page padded to 9 with `present:false` — plus a
// per-page `titles` list. The grid indexes tiles[page*9 + slot], so paging is
// pure property math: no models rebuilt, no Rust round-trip per flip. Each tile
// carries its launch `idx` (its registry position), so `launch-app(idx)` still
// maps through registry::launch_state(idx). Adding an app is a REGISTRY row.

// One launcher tile's data. `present` = false renders an empty grid slot
// (page padding).
export struct LauncherTile {
    name: string,
    accent: color,
    icon-id: int,
    idx: int,
    present: bool,
}

// A per-app vector glyph, ~46x46, drawn in `tint`. id matches LAUNCHER_APPS
// order. Exported: the app switcher (#31, switcher.slint) renders its session
// cards with the same glyphs, so an app looks identical in both surfaces.
export component AppIcon {
    in property <int> id;
    in property <color> tint;
    width: 46px;
    height: 46px;

    // 0 Snake — three body segments turning up, plus a head with an eye.
    if root.id == 0: Rectangle {
        Rectangle { x: 4px;  y: 26px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 17px; y: 26px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 30px; y: 26px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 30px; y: 13px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 30px; y: 2px;  width: 13px; height: 13px; border-radius: 4px; background: root.tint;
            Rectangle { x: 8px; y: 3px; width: 3px; height: 3px; border-radius: 1.5px; background: Theme.on-accent; } }
    }
    // 2 — 2048: a 2x2 tile grid.
    if root.id == 2: Rectangle {
        Rectangle { x: 4px;  y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint; }
        Rectangle { x: 25px; y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.55); }
        Rectangle { x: 4px;  y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.55); }
        Rectangle { x: 25px; y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint; }
    }
    // 3 — Tetris: an L-tetromino (4 blocks).
    if root.id == 3: Rectangle {
        Rectangle { x: 8px;  y: 3px;  width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 8px;  y: 16px; width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 8px;  y: 29px; width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 21px; y: 29px; width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
    }
    // 6 — Settings: three slider rows with knobs at different positions.
    if root.id == 6: Rectangle {
        Rectangle { x: 4px;  y: 8px;  width: 38px; height: 3px; border-radius: 1.5px; background: root.tint.with-alpha(0.4);
            Rectangle { x: 24px; y: -4px; width: 10px; height: 10px; border-radius: 5px; background: root.tint; } }
        Rectangle { x: 4px;  y: 21px; width: 38px; height: 3px; border-radius: 1.5px; background: root.tint.with-alpha(0.4);
            Rectangle { x: 6px;  y: -4px; width: 10px; height: 10px; border-radius: 5px; background: root.tint; } }
        Rectangle { x: 4px;  y: 34px; width: 38px; height: 3px; border-radius: 1.5px; background: root.tint.with-alpha(0.4);
            Rectangle { x: 18px; y: -4px; width: 10px; height: 10px; border-radius: 5px; background: root.tint; } }
    }
    // 1 — World Snake: a globe (circle + equator + meridian capsule).
    if root.id == 1: Rectangle {
        Rectangle { x: 3px; y: 3px; width: 40px; height: 40px; border-radius: 20px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 5px; y: 21px; width: 36px; height: 3px; background: root.tint; }
        Rectangle { x: 15px; y: 3px; width: 16px; height: 40px; border-radius: 8px; border-width: 2px; border-color: root.tint; }
    }
    // 4 — Flappy Bird: round body + wing + eye + a little beak.
    if root.id == 4: Rectangle {
        Rectangle { x: 7px; y: 10px; width: 28px; height: 28px; border-radius: 14px; background: root.tint;
            Rectangle { x: 4px; y: 12px; width: 12px; height: 9px; border-radius: 4px; background: root.tint.with-alpha(0.45); } // wing
            Rectangle { x: 19px; y: 7px; width: 4px; height: 4px; border-radius: 2px; background: Theme.on-accent; } // eye
        }
        Rectangle { x: 34px; y: 21px; width: 7px; height: 5px; border-radius: 1px; background: Theme.warm; } // beak
    }
    // 5 — Maze (Tilt): outer wall + inner path segments + the ball.
    if root.id == 5: Rectangle {
        Rectangle { x: 3px; y: 3px; width: 40px; height: 40px; border-radius: 6px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 3px;  y: 17px; width: 22px; height: 3px; background: root.tint; }
        Rectangle { x: 22px; y: 17px; width: 3px;  height: 15px; background: root.tint; }
        Rectangle { x: 22px; y: 29px; width: 18px; height: 3px; background: root.tint; }
        Rectangle { x: 32px; y: 8px;  width: 6px;  height: 6px; border-radius: 3px; background: root.tint; } // ball
    }
    // 7 — Voice: a mic (head capsule + stand + base). Drawn, ready for its tile
    // once the voice feature lands in LAUNCHER_APPS (no live tile yet).
    if root.id == 7: Rectangle {
        Rectangle { x: 15px; y: 4px; width: 16px; height: 26px; border-radius: 8px; background: root.tint; }
        Rectangle { x: 21px; y: 31px; width: 4px; height: 8px; background: root.tint; }
        Rectangle { x: 12px; y: 40px; width: 22px; height: 3px; border-radius: 1.5px; background: root.tint; }
    }
    // 8 — Radio scan: a spectrum of bars (matches the RS5 energy strip). Drawn,
    // ready for its tile once radio-scan lands (no live tile yet).
    if root.id == 8: Rectangle {
        Rectangle { x: 4px;  y: 26px; width: 6px; height: 14px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 13px; y: 16px; width: 6px; height: 24px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 22px; y: 8px;  width: 6px; height: 32px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 31px; y: 19px; width: 6px; height: 21px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 40px; y: 30px; width: 6px; height: 10px; border-radius: 2px; background: root.tint; }
    }
    // 9 — WLED: a lightbulb (glass globe + filament dot + tapering screw base).
    if root.id == 9: Rectangle {
        Rectangle { x: 11px; y: 3px;  width: 24px; height: 24px; border-radius: 12px; background: root.tint; }
        Rectangle { x: 20px; y: 12px; width: 6px;  height: 6px;  border-radius: 3px; background: Theme.on-accent; }
        Rectangle { x: 16px; y: 26px; width: 14px; height: 5px;  border-radius: 1px; background: root.tint.with-alpha(0.7); }
        Rectangle { x: 18px; y: 32px; width: 10px; height: 4px;  border-radius: 1px; background: root.tint.with-alpha(0.5); }
        Rectangle { x: 20px; y: 37px; width: 6px;  height: 3px;  border-radius: 1px; background: root.tint.with-alpha(0.4); }
    }
    // 10 — Hunt: a radar/target (concentric rings + centre pip) for the RSSI hunt.
    if root.id == 10: Rectangle {
        Rectangle { x: 3px;  y: 3px;  width: 40px; height: 40px; border-radius: 20px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 11px; y: 11px; width: 24px; height: 24px; border-radius: 12px; border-width: 2px; border-color: root.tint.with-alpha(0.6); }
        Rectangle { x: 19px; y: 19px; width: 8px;  height: 8px;  border-radius: 4px; background: root.tint; }
    }
    // 11 — Energy: a battery cell (outline + terminal) with a charge bolt.
    if root.id == 11: Rectangle {
        Rectangle { x: 5px;  y: 11px; width: 30px; height: 24px; border-radius: 4px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 35px; y: 18px; width: 5px;  height: 10px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 20px; y: 13px; width: 6px;  height: 12px; border-radius: 1px; background: Theme.warm; }
        Rectangle { x: 15px; y: 21px; width: 6px;  height: 12px; border-radius: 1px; background: Theme.warm; }
    }
    // 12 — Climate: a thermometer (stem outline + bulb + mercury column + ticks).
    if root.id == 12: Rectangle {
        Rectangle { x: 18px; y: 3px;  width: 11px; height: 30px; border-radius: 5.5px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 14px; y: 26px; width: 19px; height: 19px; border-radius: 9.5px; background: root.tint; }
        Rectangle { x: 21px; y: 16px; width: 5px;  height: 18px; border-radius: 2.5px; background: root.tint; }
        Rectangle { x: 31px; y: 11px; width: 6px;  height: 2px;  border-radius: 1px; background: root.tint; }
        Rectangle { x: 31px; y: 19px; width: 6px;  height: 2px;  border-radius: 1px; background: root.tint; }
    }
    // 13 — Theme: a 2x2 swatch grid (the picker's schemes) at descending alpha.
    if root.id == 13: Rectangle {
        Rectangle { x: 4px;  y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint; }
        Rectangle { x: 25px; y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.75); }
        Rectangle { x: 4px;  y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.5); }
        Rectangle { x: 25px; y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.3); }
    }
    // 14 — Lights (#39): a GLOWING bulb — filled globe with radiating ticks
    // (distinct from WLED's plain bulb, id 9) + tapering screw base.
    if root.id == 14: Rectangle {
        Rectangle { x: 14px; y: 10px; width: 18px; height: 18px; border-radius: 9px; background: root.tint;
            Rectangle { x: 6px; y: 6px; width: 5px; height: 5px; border-radius: 2.5px; background: Theme.on-accent; } }
        Rectangle { x: 21px; y: 1px;  width: 4px;  height: 6px; border-radius: 2px; background: root.tint.with-alpha(0.8); }  // ray up
        Rectangle { x: 4px;  y: 17px; width: 7px;  height: 4px; border-radius: 2px; background: root.tint.with-alpha(0.8); }  // ray left
        Rectangle { x: 35px; y: 17px; width: 7px;  height: 4px; border-radius: 2px; background: root.tint.with-alpha(0.8); }  // ray right
        Rectangle { x: 8px;  y: 4px;  width: 5px;  height: 5px; border-radius: 2.5px; background: root.tint.with-alpha(0.55); } // spark NW
        Rectangle { x: 33px; y: 4px;  width: 5px;  height: 5px; border-radius: 2.5px; background: root.tint.with-alpha(0.55); } // spark NE
        Rectangle { x: 17px; y: 29px; width: 12px; height: 4px; border-radius: 1px; background: root.tint.with-alpha(0.7); }
        Rectangle { x: 19px; y: 34px; width: 8px;  height: 3px; border-radius: 1px; background: root.tint.with-alpha(0.5); }
        Rectangle { x: 20px; y: 38px; width: 6px;  height: 3px; border-radius: 1px; background: root.tint.with-alpha(0.4); }
    }
    // 15 — Ping (#35): a sparkle-ripple — warm greeting radiating out. One
    // ripple ring + a bright core + four satellite sparks at falling alpha
    // (distinct from Hunt's concentric target, id 10: off-centre, sparks
    // instead of rings, filled core).
    if root.id == 15: Rectangle {
        Rectangle { x: 6px;  y: 10px; width: 30px; height: 30px; border-radius: 15px; border-width: 3px; border-color: root.tint.with-alpha(0.6); }
        Rectangle { x: 15px; y: 19px; width: 12px; height: 12px; border-radius: 6px;  background: root.tint; }
        Rectangle { x: 36px; y: 4px;  width: 7px;  height: 7px;  border-radius: 3.5px; background: root.tint; }
        Rectangle { x: 40px; y: 16px; width: 5px;  height: 5px;  border-radius: 2.5px; background: root.tint.with-alpha(0.7); }
        Rectangle { x: 33px; y: 37px; width: 6px;  height: 6px;  border-radius: 3px;  background: root.tint.with-alpha(0.55); }
        Rectangle { x: 41px; y: 30px; width: 4px;  height: 4px;  border-radius: 2px;  background: root.tint.with-alpha(0.4); }
    }
    // 16 — Story (#story): an open book, with a sound arc off the right page to
    // say "this one is read aloud" rather than just "text".
    if root.id == 16: Rectangle {
        // spine
        Rectangle { x: 23px; y: 8px;  width: 3px;  height: 32px; background: root.tint.with-alpha(0.75); }
        // left page
        Rectangle { x: 6px;  y: 10px; width: 16px; height: 28px; border-radius: 2px; border-width: 2px; border-color: root.tint; }
        // right page
        Rectangle { x: 27px; y: 10px; width: 16px; height: 28px; border-radius: 2px; border-width: 2px; border-color: root.tint.with-alpha(0.85); }
        // three text lines on the left page
        Rectangle { x: 10px; y: 16px; width: 9px;  height: 2px; background: root.tint.with-alpha(0.55); }
        Rectangle { x: 10px; y: 22px; width: 9px;  height: 2px; background: root.tint.with-alpha(0.55); }
        Rectangle { x: 10px; y: 28px; width: 6px;  height: 2px; background: root.tint.with-alpha(0.4); }
        // sound arc: two pips stepping out from the right page
        Rectangle { x: 33px; y: 20px; width: 4px;  height: 4px; border-radius: 2px;  background: root.tint; }
        Rectangle { x: 38px; y: 18px; width: 3px;  height: 8px; border-radius: 1.5px; background: root.tint.with-alpha(0.6); }
    }
}

// One app tile: icon over label, sized for the 3x3 page grid (114x108).
// Carries its launch idx. PressTile (Recipe A) supplies the feedback: fill
// lights to accent-bg + border ignites in the tile's OWN accent on
// finger-down — hard 1-frame swap, no animation. Label is ink for legibility
// (design spec §6 #1), elided if a long name outgrows the narrower tile.
component AppTile {
    in property <string> name;
    in property <color> accent;
    in property <int> icon-id;
    in property <int> idx;
    callback launch(int);
    PressTile {
        ignite: root.accent;
        clicked => { root.launch(root.idx); }
        AppIcon {
            x: (parent.width - self.width) / 2;
            y: 14px;
            id: root.icon-id;
            tint: root.accent;
        }
        Text {
            x: 4px;
            y: 72px;
            width: parent.width - 8px;
            horizontal-alignment: center;
            overflow: elide;
            text: root.name;
            color: Theme.ink;
            font-size: 15px;
            font-weight: 600;
        }
    }
}

export component LauncherOverlay {
    callback launch-app(int);
    // Flat page-major tile list from Rust (build_launcher_pages): page-count
    // pages × 9 slots, padded with present:false. AUDIO is page 0 (Rust emits
    // it first) so Voice/Sound are reachable the instant the launcher opens.
    in property <[LauncherTile]> tiles: [];
    // One section title per page ("AUDIO" / "GAMES" / "SYSTEM").
    in property <[string]> titles: [];
    in property <int> page-count: 1;
    // Current page. Flipped by the Rust shell on swipe up/down (handle_touch)
    // and by the indicator-dots tap below; two-way bound through WatchShell.
    in-out property <int> page: 0;

    // 3x3 grid geometry — keep in sync with LAUNCHER_PAGE_SLOTS (slint_shell.rs).
    // Grid area x22..388, y96..444: 3 cols of 114 + 2x12 gutters, 3 rows of
    // 108 + 2x12; ends 4px above the indicator dots at y448.
    property <length> tile-w: 114px;
    property <length> tile-h: 108px;
    property <length> gutter: 12px;

    // Scrim — the per-scheme token, so Paper gets its warm light scrim instead
    // of a hardcoded Midnight-dark one.
    //
    // #75 / `covered` in shell.slint: this token is 95 % opaque (Midnight
    // `#05080af2`, Paper `#d8d4c8ee`), so the watchface used to read through it
    // at ~5 % — teal clock digits landed at RGB(17,20,23) over an RGB(5,8,10)
    // scrim, i.e. 2 of 31 RGB565 levels, and only in the 12px tile gutters and
    // the top strip, where it fought the APPS eyebrow and the section title.
    // Buying that ghost cost the whole watchface page + chrome in the scene:
    // 92 items / 62 glyph textures / 27 rounded rects on top of the launcher's
    // own 102 / 50 / 51, which is what pushed `PrepareScene`'s doubling Vecs
    // onto the 4 096 / 3 584 / 3 328 B rungs that fail at 54-66 kB free. The
    // shell now hides the covered content while the launcher is up. To restore
    // the ghost, drop `root.launcher-open` from `covered` in shell.slint — and
    // expect the launcher to re-cross those rungs.
    Rectangle { width: 100%; height: 100%; background: Theme.scrim; }
    OverlaySwallow {} // #54: chrome beneath must never be hit-testable

    // Eyebrow keeps the launcher's identity; the big PageTitle names the
    // current SECTION (one section per page).
    Text {
        x: (parent.width - self.width) / 2;
        y: 36px;
        text: "APPS";
        color: Theme.faint;
        font-size: 12px;
        letter-spacing: 3px;
    }
    PageTitle { title: root.titles[root.page]; }

    // Current page's tiles: fixed 9-slot grid, pure index math — a page flip
    // re-binds 9 tiles and renders ONCE (hard cut, no intermediate frames).
    for slot in 9: Rectangle {
        x: 22px + mod(slot, 3) * (root.tile-w + root.gutter);
        y: 96px + floor(slot / 3) * (root.tile-h + root.gutter);
        width: root.tile-w;
        height: root.tile-h;
        // `visible:`-gated, not `if`-gated: identical culling (draw + input)
        // without the generated-inner-component ROM cost (gesture-shell diet
        // idiom — see shade.slint). The overlay itself stays `if`-gated in
        // shell.slint, so nothing here is resident while the launcher is shut.
        AppTile {
            visible: root.tiles[root.page * 9 + slot].present;
            width: 100%; height: 100%;
            name: root.tiles[root.page * 9 + slot].name;
            accent: root.tiles[root.page * 9 + slot].accent;
            icon-id: root.tiles[root.page * 9 + slot].icon-id;
            idx: root.tiles[root.page * 9 + slot].idx;
            launch(i) => { root.launch-app(i); }
        }
    }

    // Page-indicator dots (launcher's own — the shell's dots sit under this
    // overlay): tap advances (wraps), swipe up/down flips. IconButton supplies
    // the pressed accent-bg halo; idle dots ignite while held.
    dots := IconButton {
        x: (parent.width - self.width) / 2;
        y: 448px;
        width: 160px;
        height: 44px;
        clicked => { root.page = mod(root.page + 1, max(root.page-count, 1)); }
        HorizontalLayout {
            x: (parent.width - root.page-count * 10px
                - (root.page-count - 1) * 12px) / 2;
            y: (parent.height - 10px) / 2 - 2px;
            spacing: 12px;
            for i in root.page-count: Rectangle {
                width: 10px; height: 10px; border-radius: 5px;
                background: root.page == i ? Theme.accent
                    : (dots.pressed ? Theme.soft : Theme.line);
            }
        }
    }
}
