import { Theme, PageTitle } from "theme.slint";

// Categorised launcher with drawn vector icons + big finger tiles. Icons are
// lightweight Slint shapes (no bitmaps) so they cost no RAM/flash and render
// crisp on the RGB565 sw renderer.
//
// The tile content is DATA-DRIVEN: `rows` is pushed from Rust, built from the
// app REGISTRY (src/apps/registry.rs, the single source of truth). Each tile
// carries its launch `idx` (its registry position), so `launch-app(idx)` still
// maps through registry::launch_state(idx). Adding an app is a REGISTRY row —
// no tile edit here (only a new AppIcon glyph if the icon-id is new).

// One launcher tile's data. `present` = false renders a half-width spacer (a
// lone tile at the end of a section).
export struct LauncherTile {
    name: string,
    accent: color,
    icon-id: int,
    idx: int,
    present: bool,
}

// One launcher row: either a section header, or a pair of tiles (b may be a
// spacer). Rust chunks each section's apps two-per-row.
export struct LauncherRow {
    is-header: bool,
    header: string,
    a: LauncherTile,
    b: LauncherTile,
}

// A per-app vector glyph, ~46x46, drawn in `tint`. id matches LAUNCHER_APPS order.
component AppIcon {
    in property <int> id;
    in property <color> tint;
    width: 46px;
    height: 46px;

    // 0 Snake — three body segments turning up, plus a head with an eye.
    if root.id == 0: Rectangle {
        Rectangle { x: 4px;  y: 26px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 17px; y: 26px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 30px; y: 26px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 30px; y: 13px; width: 12px; height: 12px; border-radius: 3px; background: root.tint; }
        Rectangle { x: 30px; y: 2px;  width: 13px; height: 13px; border-radius: 4px; background: root.tint;
            Rectangle { x: 8px; y: 3px; width: 3px; height: 3px; border-radius: 1.5px; background: Theme.on-accent; } }
    }
    // 2 — 2048: a 2x2 tile grid.
    if root.id == 2: Rectangle {
        Rectangle { x: 4px;  y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint; }
        Rectangle { x: 25px; y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.55); }
        Rectangle { x: 4px;  y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.55); }
        Rectangle { x: 25px; y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint; }
    }
    // 3 — Tetris: an L-tetromino (4 blocks).
    if root.id == 3: Rectangle {
        Rectangle { x: 8px;  y: 3px;  width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 8px;  y: 16px; width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 8px;  y: 29px; width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 21px; y: 29px; width: 13px; height: 13px; border-radius: 2px; background: root.tint; }
    }
    // 6 — Settings: three slider rows with knobs at different positions.
    if root.id == 6: Rectangle {
        Rectangle { x: 4px;  y: 8px;  width: 38px; height: 3px; border-radius: 1.5px; background: root.tint.with-alpha(0.4);
            Rectangle { x: 24px; y: -4px; width: 10px; height: 10px; border-radius: 5px; background: root.tint; } }
        Rectangle { x: 4px;  y: 21px; width: 38px; height: 3px; border-radius: 1.5px; background: root.tint.with-alpha(0.4);
            Rectangle { x: 6px;  y: -4px; width: 10px; height: 10px; border-radius: 5px; background: root.tint; } }
        Rectangle { x: 4px;  y: 34px; width: 38px; height: 3px; border-radius: 1.5px; background: root.tint.with-alpha(0.4);
            Rectangle { x: 18px; y: -4px; width: 10px; height: 10px; border-radius: 5px; background: root.tint; } }
    }
    // 1 — World Snake: a globe (circle + equator + meridian capsule).
    if root.id == 1: Rectangle {
        Rectangle { x: 3px; y: 3px; width: 40px; height: 40px; border-radius: 20px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 5px; y: 21px; width: 36px; height: 3px; background: root.tint; }
        Rectangle { x: 15px; y: 3px; width: 16px; height: 40px; border-radius: 8px; border-width: 2px; border-color: root.tint; }
    }
    // 4 — Flappy Bird: round body + wing + eye + a little beak.
    if root.id == 4: Rectangle {
        Rectangle { x: 7px; y: 10px; width: 28px; height: 28px; border-radius: 14px; background: root.tint;
            Rectangle { x: 4px; y: 12px; width: 12px; height: 9px; border-radius: 4px; background: root.tint.with-alpha(0.45); } // wing
            Rectangle { x: 19px; y: 7px; width: 4px; height: 4px; border-radius: 2px; background: Theme.on-accent; } // eye
        }
        Rectangle { x: 34px; y: 21px; width: 7px; height: 5px; border-radius: 1px; background: Theme.warm; } // beak
    }
    // 5 — Maze (Tilt): outer wall + inner path segments + the ball.
    if root.id == 5: Rectangle {
        Rectangle { x: 3px; y: 3px; width: 40px; height: 40px; border-radius: 6px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 3px;  y: 17px; width: 22px; height: 3px; background: root.tint; }
        Rectangle { x: 22px; y: 17px; width: 3px;  height: 15px; background: root.tint; }
        Rectangle { x: 22px; y: 29px; width: 18px; height: 3px; background: root.tint; }
        Rectangle { x: 32px; y: 8px;  width: 6px;  height: 6px; border-radius: 3px; background: root.tint; } // ball
    }
    // 7 — Voice: a mic (head capsule + stand + base). Drawn, ready for its tile
    // once the voice feature lands in LAUNCHER_APPS (no live tile yet).
    if root.id == 7: Rectangle {
        Rectangle { x: 15px; y: 4px; width: 16px; height: 26px; border-radius: 8px; background: root.tint; }
        Rectangle { x: 21px; y: 31px; width: 4px; height: 8px; background: root.tint; }
        Rectangle { x: 12px; y: 40px; width: 22px; height: 3px; border-radius: 1.5px; background: root.tint; }
    }
    // 8 — Radio scan: a spectrum of bars (matches the RS5 energy strip). Drawn,
    // ready for its tile once radio-scan lands (no live tile yet).
    if root.id == 8: Rectangle {
        Rectangle { x: 4px;  y: 26px; width: 6px; height: 14px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 13px; y: 16px; width: 6px; height: 24px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 22px; y: 8px;  width: 6px; height: 32px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 31px; y: 19px; width: 6px; height: 21px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 40px; y: 30px; width: 6px; height: 10px; border-radius: 2px; background: root.tint; }
    }
    // 9 — WLED: a lightbulb (glass globe + filament dot + tapering screw base).
    if root.id == 9: Rectangle {
        Rectangle { x: 11px; y: 3px;  width: 24px; height: 24px; border-radius: 12px; background: root.tint; }
        Rectangle { x: 20px; y: 12px; width: 6px;  height: 6px;  border-radius: 3px; background: Theme.on-accent; }
        Rectangle { x: 16px; y: 26px; width: 14px; height: 5px;  border-radius: 1px; background: root.tint.with-alpha(0.7); }
        Rectangle { x: 18px; y: 32px; width: 10px; height: 4px;  border-radius: 1px; background: root.tint.with-alpha(0.5); }
        Rectangle { x: 20px; y: 37px; width: 6px;  height: 3px;  border-radius: 1px; background: root.tint.with-alpha(0.4); }
    }
    // 10 — Hunt: a radar/target (concentric rings + centre pip) for the RSSI hunt.
    if root.id == 10: Rectangle {
        Rectangle { x: 3px;  y: 3px;  width: 40px; height: 40px; border-radius: 20px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 11px; y: 11px; width: 24px; height: 24px; border-radius: 12px; border-width: 2px; border-color: root.tint.with-alpha(0.6); }
        Rectangle { x: 19px; y: 19px; width: 8px;  height: 8px;  border-radius: 4px; background: root.tint; }
    }
    // 11 — Energy: a battery cell (outline + terminal) with a charge bolt.
    if root.id == 11: Rectangle {
        Rectangle { x: 5px;  y: 11px; width: 30px; height: 24px; border-radius: 4px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 35px; y: 18px; width: 5px;  height: 10px; border-radius: 2px; background: root.tint; }
        Rectangle { x: 20px; y: 13px; width: 6px;  height: 12px; border-radius: 1px; background: Theme.warm; }
        Rectangle { x: 15px; y: 21px; width: 6px;  height: 12px; border-radius: 1px; background: Theme.warm; }
    }
    // 12 — Climate: a thermometer (stem outline + bulb + mercury column + ticks).
    if root.id == 12: Rectangle {
        Rectangle { x: 18px; y: 3px;  width: 11px; height: 30px; border-radius: 5.5px; border-width: 3px; border-color: root.tint; }
        Rectangle { x: 14px; y: 26px; width: 19px; height: 19px; border-radius: 9.5px; background: root.tint; }
        Rectangle { x: 21px; y: 16px; width: 5px;  height: 18px; border-radius: 2.5px; background: root.tint; }
        Rectangle { x: 31px; y: 11px; width: 6px;  height: 2px;  border-radius: 1px; background: root.tint; }
        Rectangle { x: 31px; y: 19px; width: 6px;  height: 2px;  border-radius: 1px; background: root.tint; }
    }
    // 13 — Theme: a 2x2 swatch grid (the picker's schemes) at descending alpha.
    if root.id == 13: Rectangle {
        Rectangle { x: 4px;  y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint; }
        Rectangle { x: 25px; y: 4px;  width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.75); }
        Rectangle { x: 4px;  y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.5); }
        Rectangle { x: 25px; y: 25px; width: 17px; height: 17px; border-radius: 4px; background: root.tint.with-alpha(0.3); }
    }
}

// One big app tile: icon over label. Carries its launch idx.
component AppTile {
    in property <string> name;
    in property <color> accent;
    in property <int> icon-id;
    in property <int> idx;
    callback launch(int);
    height: 116px;
    Rectangle {
        border-radius: 16px;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.line;
        AppIcon {
            x: (parent.width - self.width) / 2;
            y: 18px;
            id: root.icon-id;
            tint: root.accent;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 78px;
            text: root.name;
            color: Theme.soft;
            font-size: 17px;
            font-weight: 600;
        }
        TouchArea { clicked => { root.launch(root.idx); } }
    }
}

component SectionHeader {
    in property <string> title;
    height: 30px;
    Text {
        x: 0; y: 6px;
        text: root.title;
        color: Theme.dim;
        font-size: 14px;
        letter-spacing: 3px;
    }
}

export component LauncherOverlay {
    callback launch-app(int);
    // Rows built from the app REGISTRY in Rust (build_scene). Section display
    // order + two-per-row chunking are done there; this just lays them out.
    in property <[LauncherRow]> rows;
    // Total scroll-content height, computed in Rust from the same rows (see
    // `launcher_content_height` in slint_shell.rs) and pushed straight to the
    // Flickable's viewport. It is NOT read from the layout's `preferred-height`:
    // a VerticalLayout whose only child is a `for` repeater under-reports it, so
    // the viewport collapsed shorter than its content and the bottom SYSTEM rows
    // were unreachable — the v0.7.0 scroll regression this restores.
    in property <length> content-height;

    // Scrim (watchface faintly behind).
    Rectangle { width: 100%; height: 100%; background: #05080aF2; }

    // Title uses the shared PageTitle convention (#31) — same y/size/letter-
    // spacing as every other overlay's heading; the Flickable drops to y96 to
    // clear it (matching the climate/list content start).
    PageTitle { title: "APPS"; }

    Flickable {
        x: 22px; y: 96px;
        width: parent.width - 44px;
        height: parent.height - 112px;
        // Viewport height is pushed from Rust (content-height), sized to the exact
        // header/tile/gap total so every SYSTEM row is reachable for any app count.
        viewport-height: root.content-height;
        VerticalLayout {
            spacing: 12px;
            // AUDIO section is emitted first by Rust so Voice/Sound are reachable
            // the instant the launcher opens (on-glass the Flickable scroll is
            // flaky). Ordering + idx come from the registry.
            for row in root.rows: Rectangle {
                height: row.is-header ? 30px : 116px;
                if row.is-header: SectionHeader {
                    width: 100%;
                    title: row.header;
                }
                if !row.is-header: HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 12px;
                    AppTile {
                        name: row.a.name;
                        accent: row.a.accent;
                        icon-id: row.a.icon-id;
                        idx: row.a.idx;
                        launch(i) => { root.launch-app(i); }
                    }
                    if row.b.present: AppTile {
                        name: row.b.name;
                        accent: row.b.accent;
                        icon-id: row.b.icon-id;
                        idx: row.b.idx;
                        launch(i) => { root.launch-app(i); }
                    }
                    // spacer keeps a lone end-of-section tile half-width
                    if !row.b.present: Rectangle { }
                }
            }
        }
    }
}
