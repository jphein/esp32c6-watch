import { Theme, PageTitle } from "theme.slint";
import { OverlaySwallow, BackChevron, Stepper } from "controls.slint";

// #30 — one spectrum band: bar level + peak-hold tick, both dBFS in [-60, 0]
// (the meter's scale). Rust pushes 12 of these per Sound tick (~15 Hz), one
// per log-spaced band 80 Hz → 8 kHz (band table: mic-dsp::BAND_EDGE_BINS).
export struct SpecBand {
    level: float,
    peak: float,
}

// MC4 — standalone "Sound Level" dBFS meter screen. Overlay-style: MC5 shows it
// via `if root.mic-open: SoundLevel {}` (same pattern as launcher/AOD) and
// forwards the two input properties. This component is pure presentation — Rust
// (MC3) pushes the values, this only renders. NOT wired into WatchShell yet.
//
// Interface (named to match the mic-capture plan so MC5 is a clean drop-in):
//   in property <float> mic-dbfs : current level, dBFS, expected [-60, 0]
//   in property <float> mic-peak : peak-hold value, dBFS, expected [-60, 0]
// -60 dBFS = silence floor (empty bar), 0 dBFS = full scale (bar railed).
export component SoundLevel {
    in property <float> mic-dbfs: -60;
    in property <float> mic-peak: -60;
    // Real-FFT spectrum (#30): 12 log-spaced bands 80 Hz → 8 kHz, pushed by
    // Rust once per Sound tick. Replaces the old scrolling waveform.
    in property <[SpecBand]> spectrum: [];
    // Mic digital-gain stepper (0..+18 dB). Rust owns the value + clamping; the
    // − / + buttons just emit intent. The live meter above reflects the change.
    in property <int> gain-db: 0;
    callback gain-down();
    callback gain-up();
    // Back-chevron / right-swipe close (parity with every other overlay). The
    // right-swipe path is handled in the Rust shell (OVERLAYS table); this is the
    // visible tap affordance so the screen isn't a gesture-only trap.
    callback close();

    // dBFS [-60,0] -> fill fraction [0,1]. clamp() guards out-of-range pushes.
    property <float> fill: clamp((root.mic-dbfs + 60) / 60, 0.0, 1.0);
    property <float> peak-fill: clamp((root.mic-peak + 60) / 60, 0.0, 1.0);
    // Zone colour, mirrors the bar: teal quiet -> gold mid -> red near full scale.
    property <color> level-color: root.mic-dbfs >= -6 ? Theme.warn
        : (root.mic-dbfs >= -20 ? Theme.warm : Theme.accent);

    // Meter track geometry (shared by fill, ticks, peak marker, scale labels).
    property <length> bar-x: (root.width - 340px) / 2;     // 35px side inset
    property <length> bar-w: 340px;
    property <length> bar-y: 284px;

    // Opaque AMOLED backdrop — this screen fully replaces the watchface.
    Rectangle { width: 100%; height: 100%; background: Theme.bg; }
    OverlaySwallow {} // #54: chrome beneath must never be hit-testable

    PageTitle { title: "SOUND LEVEL"; }

    // Back chevron — shared BackChevron component (controls.slint): one canonical
    // 78x64 placement so overlays never drift. Right-swipe also closes (Rust
    // shell). Sits top-left, above the spectrum band.
    BackChevron { clicked => { root.close(); } }

    // Real-FFT spectrum analyzer (#30, factory-firmware parity): 12 log-spaced
    // bands 80 Hz → 8 kHz, one bottom-anchored bar per band plus a peak-hold
    // tick that lingers after transients (meter-peak feel). dBFS → height uses
    // the meter's [-60, 0] mapping; bar colours reuse the old waveform's zone
    // thresholds. The band sits between the title and the hero number.
    HorizontalLayout {
        x: root.bar-x;
        y: 96px;
        width: root.bar-w;
        height: 60px;
        spacing: 4px;
        for b in root.spectrum: Rectangle {
            // Faint column track so the 12 bands read even in silence.
            background: Theme.track;
            border-radius: 3px;
            Rectangle {
                property <float> lvl: clamp((b.level + 60) / 60, 0.0, 1.0);
                width: 100%;
                height: max(2px, parent.height * self.lvl);
                y: parent.height - self.height;
                border-radius: 3px;
                background: self.lvl >= 0.85 ? Theme.warn
                    : (self.lvl >= 0.5 ? Theme.warm : Theme.accent);
            }
            // Peak-hold tick — hidden at the silence floor.
            Rectangle {
                property <float> pk: clamp((b.peak + 60) / 60, 0.0, 1.0);
                visible: b.peak > -59.5;
                width: 100%;
                height: 2px;
                y: clamp(parent.height * (1 - self.pk) - 1px, 0px, parent.height - 2px);
                background: Theme.ink;
            }
        }
    }

    // Hero numeric readout, coloured by zone. "-inf" at the silence floor.
    Text {
        x: (parent.width - self.width) / 2;
        y: 162px;
        text: root.mic-dbfs <= -59.5 ? "-\u{221e}" : "\{round(root.mic-dbfs)}";
        color: root.level-color;
        font-size: 84px;
        font-weight: 700;
    }
    Text {
        x: (parent.width - self.width) / 2;
        y: 254px;
        text: "dBFS";
        color: Theme.dim;
        font-size: 20px;
        letter-spacing: 4px;
    }

    // Meter track.
    track := Rectangle {
        x: root.bar-x;
        y: root.bar-y;
        width: root.bar-w;
        height: 26px;
        border-radius: 13px;
        background: Theme.track;

        // Fill: reveal only the left `fill` fraction of a FULL-width zone
        // gradient (clip:true), so the tip colour reflects the real level
        // instead of a gradient squeezed into the fill width.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.fill;
            height: 100%;
            border-radius: 13px;
            clip: true;
            Rectangle {
                x: 0;
                y: 0;
                width: track.width;
                height: 100%;
                border-radius: 13px;
                background: @linear-gradient(90deg,
                    Theme.accent 0%, Theme.warm 62%, Theme.warn 100%);
            }
        }

        // Faint interior scale ticks at -40 / -20 (the two mid gridlines).
        Rectangle {
            x: parent.width * 0.333 - 0.5px; y: 4px;
            width: 1px; height: parent.height - 8px; background: Theme.line;
        }
        Rectangle {
            x: parent.width * 0.667 - 0.5px; y: 4px;
            width: 1px; height: parent.height - 8px; background: Theme.line;
        }

        // Peak-hold tick — clamped to stay inside the track.
        Rectangle {
            x: clamp(parent.width * root.peak-fill - 1.5px, 0px, parent.width - 3px);
            y: -4px;
            width: 3px;
            height: parent.height + 8px;
            border-radius: 1.5px;
            background: Theme.ink;
        }
    }

    // Scale labels under the bar (-60 / -40 / -20 / 0), centred on each tick.
    Text { x: root.bar-x - self.width / 2;                    y: root.bar-y + 40px; text: "-60"; color: Theme.dim; font-size: 13px; }
    Text { x: root.bar-x + root.bar-w * 0.333 - self.width / 2; y: root.bar-y + 40px; text: "-40"; color: Theme.dim; font-size: 13px; }
    Text { x: root.bar-x + root.bar-w * 0.667 - self.width / 2; y: root.bar-y + 40px; text: "-20"; color: Theme.dim; font-size: 13px; }
    Text { x: root.bar-x + root.bar-w - self.width / 2;        y: root.bar-y + 40px; text: "0";   color: Theme.dim; font-size: 13px; }

    // Peak-hold numeric readout.
    Text {
        x: (parent.width - self.width) / 2;
        y: root.bar-y + 74px;
        text: root.mic-peak <= -59.5 ? "peak  -\u{221e}" : "peak  \{round(root.mic-peak)} dBFS";
        color: Theme.soft;
        font-size: 15px;
        letter-spacing: 1px;
    }

    // ---------------- mic gain stepper ----------------
    // Digital boost on top of the ES7210 analog PGA; the live meter above reacts
    // as you step it, so you can dial quiet speech up to a workable level.
    // Shared Stepper (Recipe C): 56x48 finger targets (grew from 48x44 — ≥44px
    // floor with margin); pressed is a FULL INVERT to solid accent so each step
    // is acknowledged at the finger, before the meter/gain label move.
    minus-btn := Stepper {
        x: root.bar-x; y: 378px; width: 56px; height: 48px;
        glyph: "\u{2212}";
        glyph-dy: -3px;
        clicked => { root.gain-down(); }
    }
    Text {
        x: (parent.width - self.width) / 2; y: 384px;
        text: "GAIN"; color: Theme.dim; font-size: 12px; letter-spacing: 3px;
    }
    Text {
        x: (parent.width - self.width) / 2; y: 398px;
        text: "+\{root.gain-db} dB"; color: Theme.soft; font-size: 22px; font-weight: 700;
    }
    plus-btn := Stepper {
        x: root.bar-x + root.bar-w - 56px; y: 378px; width: 56px; height: 48px;
        glyph: "+";
        glyph-dy: -3px;
        clicked => { root.gain-up(); }
    }

    // Honesty caption — relative dBFS, not calibrated SPL (per the plan/spec).
    Text {
        x: (parent.width - self.width) / 2;
        y: 452px;
        text: "relative dBFS \u{00b7} not calibrated dB SPL";
        color: Theme.faint;
        font-size: 14px;
        letter-spacing: 1px;
    }
}
