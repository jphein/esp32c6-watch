def cmd_list(args) -> int:
    rows = usb_scan()
    by_serial = {r["serial"]: r for r in rows}
    out = {"fleet": [], "foreign": [], "warnings": []}
    say(f"{'SIGIL':<18} {'SERIAL':<19} {'PORT':<14} {'USB-PATH':<9} STATE")
    for sigil, serial in FLEET.items():
        r = by_serial.get(serial.upper())
        state = "present" if r else "absent"
        dev = r["dev"] if r else "-"
        path = r["port_path"] if r else "-"
        say(f"{sigil:<18} {serial:<19} {dev:<14} {path:<9} {state}")
        out["fleet"].append({"sigil": sigil, "serial": serial,
                             "dev": r["dev"] if r else None,
                             "port_path": r["port_path"] if r else None,
                             "present": bool(r),
                             "warnings": r["warnings"] if r else []})
        if r:
            out["warnings"] += r["warnings"]
    for r in rows:
        if r["sigil"] is None:
            say(f"{'(not fleet)':<18} {r['serial']:<19} {r['dev']:<14} "
                f"{r['port_path']:<9} present — do NOT flash watch firmware")
            out["foreign"].append({k: r[k] for k in
                                   ("serial", "dev", "port_path")})
    for w in out["warnings"]:
        say(f"warning: {w}")
    emit(out)
    return EXIT_OK


def cmd_logs(args) -> int:
    transport, tgt = resolve_transport(args, args.watch)
    secs = args.seconds
    collected: list[str] = []

    if transport == "wifi":
        if args.reset:
            say("watchctl: --reset is USB-only (espflash needs the wire) — "
                "capturing without reset")
        try:
            sock = wifi_connect(tgt["endpoint"], tgt["token"])
        except OSError as e:
            say(f"watchctl: cannot reach {tgt['endpoint']}: {e}")
            emit({"error": "unreachable", **tgt})
            return EXIT_RECOVERY
        reader = SocketReader(sock)
        reader.send_line("logs")
    else:
        try:
            reader = LineReader(tgt["dev"])
        except OSError as e:
            say(f"watchctl: cannot open {tgt['dev']}: {e}")
            emit({"error": "open-failed", "dev": tgt["dev"]})
            return EXIT_RECOVERY
        if args.reset:
            # Capture-before-reset: the reader is already open, so the boot
            # burst (which starts within ~100 ms of the reset) is not lost.
            try:
                p = espflash("reset", "--port", tgt["dev"], timeout=30)
                if p.returncode != 0:
                    say(f"watchctl: espflash reset failed: "
                        f"{(p.stderr or p.stdout).strip()[-200:]}")
            except subprocess.TimeoutExpired:
                say("watchctl: espflash reset timed out")

    deadline = time.monotonic() + secs
    try:
        for ln in reader.lines_until(deadline):
            if not ln.strip():
                continue
            collected.append(ln)
            if not JSON_MODE:
                print(ln, flush=True)
    except ConnectionError as e:
        say(f"watchctl: {e}")
    except KeyboardInterrupt:
        pass
    finally:
        reader.close()

    if not collected:
        if args.reset:
            busy = say_wedged_or_busy(row["dev"], args.watch)
            emit({"lines": [], "count": 0, "wedged_suspect": not busy,
                  "port_busy": busy})
            return EXIT_RECOVERY
        say("(no output — release builds light-sleep and gate serial; this "
            "is normal at idle. Use --reset for the boot burst, or a "
            "debug-console build which never sleeps.)")
    emit({"lines": collected, "count": len(collected),
          "transport": transport})
    return EXIT_OK


def cmd_reset(args) -> int:
    row = require_usb(args.watch)
    say(f"resetting {row.get('sigil') or row['dev']} ({row['dev']}) …")
    banner = reset_and_capture(row["dev"], wait=10.0)
    if banner.get("download"):
        say("chip was parked in download mode — resetting again")
        banner = reset_and_capture(row["dev"], wait=10.0)
    if banner["alive"]:
        say("OK — boot banner seen")
        say_fingerprint(banner)
        emit({"ok": True, **fingerprint(banner)})
        return EXIT_OK
    say("no boot banner after reset — auto-escalating the recovery ladder")
    code, result = recovery_ladder(row, args.watch)
    emit(result)
    return code


def cmd_recover(args) -> int:
    row = require_usb(args.watch)
    say(f"recovery ladder for {row.get('sigil') or row['dev']} "
        f"({row['dev']}, USB path {row['port_path']}) …")
    code, result = recovery_ladder(row, args.watch)
    emit(result)
    return code


def cmd_slot(args) -> int:
    row = require_usb(args.watch)
    say(f"reading boot banner of {row.get('sigil') or row['dev']} "
        f"({row['dev']}) — this resets the watch …")
    banner = reset_and_capture(row["dev"], wait=18.0,
                               need=("offset", "sigil"))
    if banner.get("offset") is None:
        busy = say_wedged_or_busy(row["dev"], args.watch)
        emit({"error": "port-busy" if busy else "no-banner",
              "port_busy": busy, "lines": banner["lines"][-40:]})
        return EXIT_RECOVERY
    say_fingerprint(banner)
    if banner.get("sigil") is None:
        say("  (no [SIGIL] line within the wait — app may have panicked "
            "before radio init; try: watchctl logs --reset)")
    emit({"ok": True, **fingerprint(banner)})
    return EXIT_OK


def _parse_slot_arg(s: str) -> int | None:
    s = s.strip().lower()
    if s in ("0", "ota_0", "a"):
        return SLOT_OFFSETS["ota_0"]
    if s in ("1", "ota_1", "b"):
        return SLOT_OFFSETS["ota_1"]
    try:
        off = int(s, 16) if s.startswith("0x") else int(s)
    except ValueError:
        return None
    return off if off in SLOT_OFFSETS.values() else None


def _image_from(path: Path, tmpdir: str) -> tuple[Path | None, str]:
    """ELF -> espflash app image (or pass a .bin through). -> (bin, kind)."""
    with open(path, "rb") as f:
        magic = f.read(4)
    if magic != b"\x7fELF":
        return path, "bin"
    out = Path(tmpdir) / (path.stem + ".bin")
    p = espflash("save-image", "--chip", "esp32c6", "--flash-size", "16mb", "--partition-table", str(PARTITIONS_CSV), str(path), str(out),
                 timeout=120)
    if p.returncode != 0:
        say(f"watchctl: espflash save-image failed: "
            f"{(p.stderr or p.stdout).strip()[-400:]}")
        return None, "elf"
    return out, "elf"


def sigil_of_image(binp: Path) -> dict:
    """Read the BUILD STAMP out of an image — the bytes about to be written.

    Marker written by `src/net/sigil.rs::BUILD_STAMP`:
    `WSIGIL:<forge name>|<git hash[*]>|v<crate version>`. A trailing `*` on the
    hash means the tree was DIRTY, so the hash is a content hash over
    HEAD+status+diff rather than a commit you can `git show`.

    Deliberately read from the file rather than recomputed from the working
    tree: the tree can move on between a build and a flash (it did, repeatedly,
    on 2026-07-29), and a version label that disagrees with the bytes is worse
    than no label because it gets trusted. Returns {} for an image with no
    marker — a build predating the stamp — which the caller must SAY rather than
    pass over in silence.
    """
    try:
        blob = binp.read_bytes()
    except OSError:
        return {}
    m = re.search(rb"WSIGIL:([^\x00]{1,96})", blob)
    if not m:
        return {}
    parts = m.group(1).decode("utf-8", "replace").split("|")
    parts += [""] * (3 - len(parts))
    return {"build": parts[0], "hash": parts[1], "version": parts[2]}


NEVER_SHIP = b"NEVER-SHIP:"
PIN_DIR = REPO / "scratch" / "flashed"


def port_holders(dev: str) -> str:
    """Who else has this tty open? Returns a human string, or "" if nobody.

    This exists because "no boot banner" is a NON-DISCRIMINATING diagnosis: it means
    the watch is wedged OR another process holds the tty, and the two look identical
    from here. On 2026-07-29 that ambiguity produced a report that a watch was bricked
    when it was answering console commands the whole time — another agent's capture
    held the port, so the read saw silence.

    An instrument whose output cannot separate the cases you care about cannot
    reassure you no matter what it prints. `fuser` separates them in one call, so
    every "wedged" verdict now carries the answer.
    """
    for cmd in (["fuser", "-v", dev], ["lsof", "-t", dev]):
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            continue
        out = (p.stdout + p.stderr).strip()
        # fuser prints PIDs to stderr and a header table; either way, non-empty
        # output naming a pid means somebody has it.
        if out and any(ch.isdigit() for ch in out):
            return " ".join(out.split())[:200]
    return ""


def say_wedged_or_busy(dev: str, watch: str) -> bool:
    """Report a missing banner, distinguishing 'busy' from 'wedged'. True = busy."""
    held = port_holders(dev)
    if held:
        say(f"no boot banner — but {dev} is HELD by another process: {held}")
        say("  that is almost certainly the cause: a held tty reads exactly like a "
            "dead device. Release it and retry before concluding anything.")
        return True
    say(f"no boot banner, and nothing else holds {dev} — the watch really is not "
        f"reaching the bootloader; run: watchctl recover {watch}")
    return False


def refuse_if_never_ship(path: Path) -> str | None:
    """Refuse to flash an image that declares itself unshippable.

    Test-only builds exist and are legitimate — `story-stub-slots` forces the
    character page's worst frame so the 512 pool rung can be measured at all. What
    is NOT legitimate is that build reaching a wrist: it does not merely carry inert
    test code, it makes the watch permanently render the worst frame in the UI, i.e.
    it ships the crash regime.

    A Cargo.toml comment cannot stop that. This can, and it is checked at the point
    bytes go onto hardware rather than only at the point someone runs preflight.
    Matched against the image itself, so it holds no matter which build path or which
    agent produced the file.
    """
    try:
        blob = path.read_bytes()
    except OSError:
        return None
    i = blob.find(NEVER_SHIP)
    if i == -1:
        return None
    end = blob.find(b"\x00", i)
    return blob[i:end if end != -1 else i + 96].decode("utf-8", "replace")


def pin_image(src: Path) -> Path:
    """Snapshot the artifact before flashing, and flash the snapshot.

    N agents share one `target/` directory, so the path a deploy reads is being
    rewritten by whoever finished building last. Observed today: an agent read the
    shared path expecting its own instrumented build and got another session's
    production image — which would have flashed prod and measured a "healthy" result
    that was really the absence of its own change. A silent no-op arriving by a route
    nobody was watching.

    Copy-then-flash closes the window, and keeping the copy means a later
    disassembly resolves against the bytes that were actually written. The repo's
    own handoff records an agent losing three disassembly passes to a rebuilt
    binary; this makes the fix the default rather than folklore.
    """
    try:
        # Already pinned? Don't pin it again. Re-stamping produced
        # `PROD-story-WroughtQuench-bcc91eb-WroughtQuench-bcc91eb-1cb1a3de.bin` when a
        # hand-named pin was deployed — cosmetic, but an unreadable name defeats the
        # whole point of putting the sigil there, which was to make provenance legible
        # at `ls` time.
        if PIN_DIR.resolve() == src.resolve().parent:
            return src
        PIN_DIR.mkdir(parents=True, exist_ok=True)
        # Name it with the image's OWN build sigil, not just a content hash.
        #
        # The first version used `<stem>-<sha12>` and that is how a pin got
        # mislabelled within the hour: a deploy pinned whatever sat at the shared
        # `target/` path, which at that moment was another agent's forced-crash
        # build, and the filename said nothing about which build it was. It was then
        # offered as "the production image to restore from" — and flashing it would
        # have installed a reboots-on-the-character-page firmware while everyone
        # believed production had been restored. That surfaces later as a mystery
        # regression, which is worse than the interrupted deploy it was meant to undo.
        #
        # Pinning the PATH is inherently racy with N agents in one target dir and
        # cannot be fixed here — you can only pin what you were handed. Putting the
        # sigil in the name makes a wrong hand-off visible at `ls` time instead of
        # requiring someone to run `strings`. Content hash stays as the tiebreaker.
        sig = sigil_of_image(src)
        words = "".join(c for c in sig.get("build", "") if c.isalnum()) or "nosigil"
        stamp = (sig.get("hash") or "").replace("*", "dirty") or "nohash"
        h = hashlib.sha256(src.read_bytes()).hexdigest()[:8]
        dst = PIN_DIR / f"{src.stem}-{words}-{stamp}-{h}{src.suffix or '.elf'}"
        if not dst.exists():
            shutil.copy2(src, dst)
        return dst
    except OSError:
        return src  # pinning is a safety net, never a blocker


def _tree_hash() -> str:
    """The current working tree's build hash, via the shared implementation."""
    script = REPO / "tools" / "build_hash.sh"
    if not script.is_file():
        return ""
    try:
        p = subprocess.run(["bash", str(script)], capture_output=True, text=True,
                           timeout=30)
    except (OSError, subprocess.SubprocessError):
        return ""
    return p.stdout.strip() if p.returncode == 0 else ""


def say_image_sigil(binp: Path) -> dict:
    """Print the image's build stamp, and shout if it does not match this tree.

    The staleness check matters more since builds moved to familiar: `fambuild`
    runs cargo on the remote host, and if the artifact is not fetched back the
    LOCAL target/ path still holds an older binary. Deploying that path then
    flashes the stale image while the build log says success — measured on
    2026-07-29 as a 664 B .bss / 784 B stack difference between the two, with no
    error anywhere. Comparing the baked-in hash against the tree catches it
    regardless of which build path produced the file.

    A warning rather than a refusal: re-flashing a deliberately older image is a
    legitimate thing to do (bisecting, reverting), and the operator can see this
    line. What is NOT legitimate is doing it without knowing.
    """
    sig = sigil_of_image(binp)
    if not sig:
        say("  no WSIGIL marker in this image — it predates the build stamp, so "
            "the watch's BUILD row cannot be compared for this flash")
        return {}
    want = _tree_hash()
    if want and sig.get("hash") and want != sig["hash"]:
        say("  " + "!" * 60)
        say(f"  HASH MISMATCH: image '{sig['hash']}' vs tree '{want}'")
        say("  TWO causes, and this test tells them apart:")
        say("    did `fambuild: fetched ...` appear in the build output?")
        say("      YES -> the tree moved DURING the build (agents commit faster "
            "than a 2-minute link). Benign: the ELF is exactly what was built.")
        say("             Trust the image's WSIGIL above; re-running fambuild just "
            "chases a moving target.")
        say("      NO  -> the remote build never came back and this path holds "
            "OLDER bytes. That is the dangerous one — rebuild before flashing.")
        say("  " + "!" * 60)
    say("  ---------------------------------------------")
    say(f"   BUILD  {sig['build']}")
    say(f"   HASH   {sig['hash']}")
    say(f"   VER    {sig['version']}")
    say("  ---- compare: SYSTEM page / Settings p4 -----")
    return sig


def cmd_deploy(args) -> int:
    row = require_usb(args.watch)
    image = Path(args.image)
    if not image.is_file():
        say(f"watchctl: no such file: {image}")
        emit({"error": "not-found", "image": str(image)})
        return EXIT_NOTFOUND

    never = refuse_if_never_ship(image)
    if never and not getattr(args, "allow_never_ship", False):
        say(f"watchctl: REFUSING to flash — this image declares '{never}'.")
        say("  a never-ship build makes the watch render the worst frame in the UI "
            "permanently; it exists to be measured, not worn")
        say("  if you are deliberately measuring it, pass --allow-never-ship")
        emit({"error": "never-ship", "marker": never})
        return EXIT_GATE
    if never:
        # The override exists so the gate can be OBEYED rather than deleted. The only
        # way to confirm the CHAR-page fix on hardware is to flash a stub build and
        # watch it NOT reboot — so an absolute refusal blocks the one test that
        # validates the fix, and the predictable response to that is someone removing
        # the check. A gate with no legitimate escape hatch becomes a gate that isn't
        # there. Loud, explicit, per-invocation, and never a config default.
        say("!" * 60)
        say(f"watchctl: never-ship override ACTIVE — flashing '{never}'")
        say("  this watch will render the worst frame in the UI. Reflash a production")
        say("  image before wearing it.")
        say("!" * 60)
    pinned = pin_image(image)
    if pinned != image:
        say(f"pinned -> {pinned}  (flashing the snapshot, not the shared path)")
    image = pinned

    with tempfile.TemporaryDirectory(prefix="watchctl-") as tmp:
        binp, kind = _image_from(image, tmp)
        if binp is None:
            emit({"error": "save-image-failed"})
            return EXIT_GATE
        size = binp.stat().st_size
        if size > IMAGE_GATE:
            say(f"watchctl: GATE FAILED — image {size} B exceeds the "
                f"{IMAGE_GATE} B OTA slot cap ({size - IMAGE_GATE} B over)")
            emit({"error": "gate-failed", "size": size, "gate": IMAGE_GATE})
            return EXIT_GATE
        say(f"image {size} B fits the slot ({IMAGE_GATE - size} B headroom)"
            + (f" [converted from ELF]" if kind == "elf" else ""))

        # The slot trap (#20): bare `espflash flash` writes ota_0 while
        # otadata may boot ota_1. ALWAYS write the slot that actually boots.
        if args.slot == "auto":
            say("detecting the BOOTING slot (reset + banner) …")
            banner = reset_and_capture(row["dev"], wait=10.0)
            if banner.get("offset") is None:
                say("could not read the booting slot — run: watchctl recover "
                    + args.watch + " (or pass --slot explicitly)")
                emit({"error": "no-banner"})
                return EXIT_RECOVERY
            target = banner["offset"]
            say(f"  booting slot = {slot_of(target)} @ {hex(target)}")
        else:
            target = _parse_slot_arg(args.slot)
            if target is None:
                say(f"watchctl: bad --slot {args.slot!r} (auto, 0, 1, ota_0, "
                    "ota_1, 0x10000, 0x410000)")
                emit({"error": "bad-slot", "slot": args.slot})
                return EXIT_NOTFOUND

        img_sigil = say_image_sigil(binp)
        say(f"writing {binp.name} -> {slot_of(target)} @ {hex(target)} "
            f"on {row['dev']} …")
        try:
            p = espflash("write-bin", "--port", row["dev"], hex(target),
                         str(binp), timeout=600)
        except subprocess.TimeoutExpired:
            say("watchctl: write-bin timed out — run: watchctl recover "
                + args.watch)
            emit({"error": "write-timeout"})
            return EXIT_RECOVERY
        if p.returncode != 0:
            say(f"watchctl: write-bin failed: "
                f"{(p.stderr or p.stdout).strip()[-400:]}")
            say("if espflash cannot sync, run: watchctl recover " + args.watch)
            emit({"error": "write-failed"})
            return EXIT_RECOVERY

    say("verifying boot (reset + banner) …")
    banner = reset_and_capture(row["dev"], wait=18.0, need=("offset", "sigil"))
    booted = banner.get("offset")
    if booted is None:
        say("NO boot banner after deploy — run: watchctl recover " + args.watch)
        emit({"error": "no-banner-after-deploy"})
        return EXIT_RECOVERY
    if booted != target:
        say(f"SLOT MISMATCH: wrote {hex(target)} but the bootloader loaded "
            f"{hex(booted)} — otadata changed underneath us (a pending OTA?); "
            "re-run deploy, or flash-full --erase-otadata to pin ota_0")
        emit({"error": "slot-mismatch", "wrote": hex(target),
              "booted": hex(booted)})
        return EXIT_RECOVERY
    say("deploy OK — new image is the booting slot and it came up:")
    say_fingerprint(banner)
    if banner.get("sigil") is None:
        say("  (no [SIGIL] line — if this build should print one, the app "
            "may be crashing; check: watchctl logs --reset " + args.watch + ")")
    emit({"ok": True, "wrote": hex(target), "size": size,
          "image": img_sigil, **fingerprint(banner)})
    return EXIT_OK


def cmd_flash_full(args) -> int:
    row = require_usb(args.watch)
    elf = Path(args.elf)
    if not elf.is_file():
        say(f"watchctl: no such file: {elf}")
        emit({"error": "not-found", "elf": str(elf)})
        return EXIT_NOTFOUND
    with open(elf, "rb") as f:
        if f.read(4) != b"\x7fELF":
            say("watchctl: flash-full needs an ELF (use deploy for a .bin)")
            emit({"error": "not-elf"})
            return EXIT_NOTFOUND
    if not PARTITIONS_CSV.is_file():
        say(f"watchctl: missing {PARTITIONS_CSV} — a full flash WITHOUT the "
            "partition table is exactly the #20 trap; refusing")
        emit({"error": "no-partition-table"})
        return EXIT_GATE

    # Gate the app image size before touching the device.
    with tempfile.TemporaryDirectory(prefix="watchctl-") as tmp:
        binp, _ = _image_from(elf, tmp)
        if binp is None:
            emit({"error": "save-image-failed"})
            return EXIT_GATE
        size = binp.stat().st_size
        if size > IMAGE_GATE:
            say(f"watchctl: GATE FAILED — image {size} B exceeds the "
                f"{IMAGE_GATE} B slot cap")
            emit({"error": "gate-failed", "size": size, "gate": IMAGE_GATE})
            return EXIT_GATE
        # Read the stamp while the derived .bin still exists (the tempdir goes
        # away below, and espflash re-derives its own copy from the ELF).
        img_sigil = say_image_sigil(binp)
    say(f"image {size} B fits the slot ({IMAGE_GATE - size} B headroom)")

    cmd = ["flash", "--chip", "esp32c6", "--port", row["dev"],
           "--partition-table", str(PARTITIONS_CSV)]
    if args.erase_otadata:
        cmd += ["--erase-parts", "otadata"]
        say("erasing otadata (boot pointer -> ota_0) as part of the flash")
    cmd.append(str(elf))
    say(f"full flash of {elf.name} onto {row.get('sigil') or row['dev']} "
        f"({row['dev']}) …")
    try:
        p = espflash(*cmd, timeout=600)
    except subprocess.TimeoutExpired:
        say("watchctl: flash timed out — run: watchctl recover " + args.watch)
        emit({"error": "flash-timeout"})
        return EXIT_RECOVERY
    if p.returncode != 0:
        say(f"watchctl: flash failed: {(p.stderr or p.stdout).strip()[-400:]}")
        say("if espflash cannot sync, run: watchctl recover " + args.watch)
        emit({"error": "flash-failed"})
        return EXIT_RECOVERY

    say("verifying boot (reset + banner) …")
    banner = reset_and_capture(row["dev"], wait=18.0, need=("offset", "sigil"))
    if not banner["alive"]:
        say("no boot banner after flash — run: watchctl recover " + args.watch)
        emit({"error": "no-banner-after-flash"})
        return EXIT_RECOVERY
    say("flash-full OK:")
    say_fingerprint(banner)
    if args.erase_otadata and banner.get("offset") not in (None,
                                                           SLOT_OFFSETS["ota_0"]):
        say(f"  NOTE: expected ota_0 after an otadata erase but booted "
            f"{hex(banner['offset'])}")
    emit({"ok": True, "image": img_sigil, "size": size, "erased_otadata": bool(args.erase_otadata),
          **fingerprint(banner)})
    return EXIT_OK


def _ui_test_argv(args, mode: list[str]) -> list[str] | None:
    transport, tgt = resolve_transport(args, args.watch)
    if transport == "usb":
        target = tgt["dev"]
        extra: list[str] = []
    else:
        target = f"tcp://{tgt['endpoint']}"
        extra = ["--token", tgt["token"]] if tgt["token"] else []
        if not tgt["token"]:
            say("warning: no WATCH_DEBUG_TOKEN in .cargo/config.toml [env] — "
                "the debug server will drop an unauthenticated connection")
    return [sys.executable, str(UI_TEST), "--port", target, *extra, *mode]


def cmd_console(args) -> int:
    argv = _ui_test_argv(args, ["repl"])
    return subprocess.call(argv)


def cmd_test(args) -> int:
    suite = {None: "suite", "default": "suite", "suite": "suite",
             "hotpaths": "hotpaths", "lights": "lights"}.get(args.suite)
    if suite is None:
        say(f"watchctl: unknown suite {args.suite!r} "
            "(default | hotpaths | lights)")
        return EXIT_NOTFOUND
    argv = _ui_test_argv(args, [suite])
    return subprocess.call(argv)


def cmd_soak(args) -> int:
    """Boot-stability harness: reset N times, classify each boot, report the
    crash-rate + time-to-crash (0% = stable). Wraps tools/watch_soak.py."""
    row = require_usb(args.watch)
    probe = REPO / "tools" / "watch_soak.py"
    if not probe.exists():
        say(f"watchctl: {probe} not found")
        return EXIT_NOTFOUND
    say(f"soaking {row.get('sigil') or row['dev']} ({row['dev']}): "
        f"{args.trials} boots x {args.seconds}s — 0% crash = stable")
    return subprocess.call([sys.executable, str(probe), row["dev"],
                            str(args.trials), str(args.seconds)])


def cmd_ota_status(args) -> int:
    out: dict = {"journal": [], "announce": None}
    say(f"— {OTA_UNIT} journal on {OTA_HOST} (last {args.lines}) —")
    try:
        p = run(["ssh", "-o", "ConnectTimeout=6", OTA_HOST,
                 f"journalctl -u {OTA_UNIT} -n {int(args.lines)} --no-pager"],
                timeout=25)
    except subprocess.TimeoutExpired:
        say(f"watchctl: ssh {OTA_HOST} timed out")
        emit({"error": "ssh-timeout"})
        return EXIT_RECOVERY
    if p.returncode != 0:
        say(f"watchctl: journal read failed: {p.stderr.strip()[-300:]}")
    else:
        for ln in p.stdout.splitlines():
            out["journal"].append(ln)
            say(ln)

    say("")
    say(f"— retained announce ({OTA_ANNOUNCE_TOPIC}) —")
    msg = mqtt_read_retained(args, OTA_ANNOUNCE_TOPIC)
    if msg is None:
        say("(no retained announce on the broker)")
    else:
        parts = msg.split("|")
        ann = {"raw": msg}
        if len(parts) >= 2 and parts[0] == "OTA":
            try:
                epoch = int(parts[1])
                ann["build"] = epoch
                ann["build_time"] = datetime.fromtimestamp(epoch).isoformat(
                    sep=" ")
            except ValueError:
                pass
            ann["url"] = parts[2] if len(parts) > 2 else ""
        out["announce"] = ann
        say(msg)
        if "build_time" in ann:
            say(f"  build id {ann['build']} = {ann['build_time']} (local)")
    emit(out)
    return EXIT_OK


def cmd_endpoint(args) -> int:
    sigil, _ = resolve_selector(args.watch)
    if sigil is None:
        say(f"watchctl: endpoint needs a fleet sigil (got {args.watch!r})")
        emit({"error": "not-found", "selector": args.watch})
        return EXIT_NOTFOUND
    topic = DEBUG_ENDPOINT_TOPIC.format(sigil=sigil)
    say(f"reading retained {topic} …")
    ep = mqtt_read_retained(args, topic)
    if ep is None:
        say(f"no retained endpoint — {sigil}'s debug server is not running "
            "(the firmware TCP debug server is the follow-on task; see "
            "docs/debugging.md 'WiFi debug channel')")
        emit({"sigil": sigil, "endpoint": None, "reachable": False})
        return EXIT_NOTFOUND
    say(f"endpoint: {ep} — probing (connect + auth + ping) …")
    token = debug_token(args)
    try:
        sock = wifi_connect(ep, token)
    except OSError as e:
        say(f"UNREACHABLE: {e} (stale retained endpoint? watch asleep/off "
            "WiFi?)")
        emit({"sigil": sigil, "endpoint": ep, "reachable": False,
              "error": str(e)})
        return EXIT_RECOVERY
    reader = SocketReader(sock)
    try:
        reader.send_line("ping")
        deadline = time.monotonic() + 4.0
        for ln in reader.lines_until(deadline):
            if "pong" in ln:
                say(f"REACHABLE — {ln.strip()}")
                emit({"sigil": sigil, "endpoint": ep, "reachable": True})
                return EXIT_OK
        say("connected but no pong within 4 s"
            + ("" if token else " — no WATCH_DEBUG_TOKEN configured, the "
               "server likely dropped the unauthenticated session"))
        emit({"sigil": sigil, "endpoint": ep, "reachable": False,
              "error": "no-pong"})
        return EXIT_RECOVERY
    except ConnectionError as e:
        say(f"connection dropped: {e} (bad/missing token?)")
        emit({"sigil": sigil, "endpoint": ep, "reachable": False,
              "error": str(e)})
        return EXIT_RECOVERY
    finally:
        reader.close()


