# --------------------------------------------------------------------------- #
# Fleet facts (hard-won — see docs/debugging.md before "simplifying" any)
# --------------------------------------------------------------------------- #
FLEET = {
    # sigil            : efuse MAC == USB serial (udev ID_SERIAL_SHORT)
    "eldritch-lantern": "98:A3:16:A7:2F:E4",
    "mythic-throne":    "98:A3:16:A5:A7:F8",
}
ESPRESSIF_VID = "303a"          # USB-Serial-JTAG debug unit VID (PID 1001)

# A/B app slots (partitions.csv). otadata decides which one BOOTS.
SLOT_OFFSETS = {"ota_0": 0x10000, "ota_1": 0x610000}  # 6MB slots (#50)
IMAGE_GATE = 6_225_920          # bytes — 6MB slot - 64KB (#50)

# USB port paths that cannot enumerate a C6 (EPROTO -71): the 1-7.x hub, and
# some mobo ports. Any hub (dotted) path gets a warning; 1-7 gets a loud one.
KNOWN_BAD_HUB = "1-7"

USBDEVFS_RESET = 21780          # ioctl on /dev/bus/usb/<bus>/<dev> (needs sudo)

# WiFi debug channel (firmware side is planned — see docs/debugging.md).
DEBUG_TCP_PORT = 5555
DEBUG_ENDPOINT_TOPIC = "watch/{sigil}/debug/endpoint"   # RETAINED "<ip>:5555"
OTA_ANNOUNCE_TOPIC = "watch/ota/announce"
OTA_HOST = "ubox0"              # OTA HTTP server + broker-reachable ssh leg
OTA_UNIT = "watch-ota.service"

# Boot-banner shapes (bootloader + firmware prints).
BOOT_OFFSET_RE = re.compile(r"Loaded app from partition at offset (0x[0-9A-Fa-f]+)")
SIGIL_RE = re.compile(r"\[SIGIL\] (\S+) \(node id (\d+)")
STACK_RE = re.compile(r"\[STACK\] gap = (\d+) B")
ROM_MARK = "ESP-ROM:"
DOWNLOAD_MARK = "waiting for download"   # ROM parked in download mode

ANSI_RE = re.compile(rb"\x1b(?:\[[0-9;?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)?|[@-Z\\^_])")

EXIT_OK, EXIT_NOTFOUND, EXIT_RECOVERY, EXIT_GATE = 0, 2, 3, 4

REPO = Path(__file__).resolve().parent.parent
UI_TEST = REPO / "tools" / "ui_test.py"
PARTITIONS_CSV = REPO / "partitions.csv"

JSON_MODE = False
VERBOSE = False


# --------------------------------------------------------------------------- #
# Output helpers
# --------------------------------------------------------------------------- #
def say(msg: str = "") -> None:
    """Human line — stdout normally, stderr under --json (stdout = JSON only)."""
    print(msg, file=sys.stderr if JSON_MODE else sys.stdout, flush=True)


def vlog(msg: str) -> None:
    if VERBOSE:
        print(f"watchctl: {msg}", file=sys.stderr, flush=True)


def emit(obj: dict) -> None:
    if JSON_MODE:
        print(json.dumps(obj, indent=2), flush=True)


def run(cmd: list[str], timeout: float = 30, **kw) -> subprocess.CompletedProcess:
    vlog("+ " + " ".join(shlex.quote(c) for c in cmd))
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)


def espflash_bin() -> str:
    return shutil.which("espflash") or str(Path.home() / ".cargo" / "bin" / "espflash")


def espflash(*args: str, timeout: float = 60) -> subprocess.CompletedProcess:
    return run([espflash_bin(), "--skip-update-check", *args], timeout=timeout)


# --------------------------------------------------------------------------- #
# Config (.cargo/config.toml [env] — gitignored, same source as ota_push.sh)
# --------------------------------------------------------------------------- #
def cfg_path(args) -> Path:
    if getattr(args, "config", None):
        return Path(args.config)
    if os.environ.get("WATCHCTL_CONFIG"):
        return Path(os.environ["WATCHCTL_CONFIG"])
    return REPO / ".cargo" / "config.toml"


def cfg_get(path: Path, key: str) -> str | None:
    """Read KEY="value" from the flat [env] section (mirrors ota_push.sh)."""
    if not path.is_file():
        return None
    m = re.search(rf'^{re.escape(key)}="(.*)"', path.read_text(), re.MULTILINE)
    return m.group(1) if m else None


def debug_token(args) -> str | None:
    """Shared secret for the WiFi debug channel (WATCH_DEBUG_TOKEN in [env])."""
    return (os.environ.get("WATCH_DEBUG_TOKEN")
            or cfg_get(cfg_path(args), "WATCH_DEBUG_TOKEN")
            or cfg_get(cfg_path(args), "WATCH_HA_TOKEN"))


# --------------------------------------------------------------------------- #
# USB enumeration — ALWAYS by serial, never by ttyACM number
# --------------------------------------------------------------------------- #
def udev_props(dev: str) -> dict[str, str]:
    try:
        p = run(["udevadm", "info", "-q", "property", "-n", dev], timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    props = {}
    for line in p.stdout.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            props[k] = v
    return props


def port_path_from_devpath(devpath: str) -> str:
    """'/devices/.../usb1/1-9/1-9:1.0/tty/ttyACM2' -> '1-9' (the USB port)."""
    parts = devpath.split("/")
    for i, p in enumerate(parts):
        if re.fullmatch(r"\d+-[\d.]+", p) and i + 1 < len(parts) \
                and parts[i + 1].startswith(p + ":"):
            return p
    return ""


def port_warnings(port_path: str, dev: str) -> list[str]:
    warns = []
    if not port_path:
        return warns
    if port_path.startswith(KNOWN_BAD_HUB + "."):
        warns.append(f"{dev} is on hub port {port_path} — this hub CANNOT "
                     "enumerate C6s (EPROTO -71); move to a direct port")
    elif "." in port_path.split("-", 1)[-1]:
        warns.append(f"{dev} is behind a USB hub ({port_path}) — C6s often "
                     "fail to enumerate on hubs (-71); prefer a direct port")
    return warns


def usb_scan() -> list[dict]:
    """All Espressif USB-Serial-JTAG ttys, with sigil attribution."""
    serial_to_sigil = {v.upper(): k for k, v in FLEET.items()}
    rows = []
    for dev in sorted(glob.glob("/dev/ttyACM*")):
        props = udev_props(dev)
        if props.get("ID_VENDOR_ID") != ESPRESSIF_VID:
            continue
        serial = (props.get("ID_SERIAL_SHORT")
                  or props.get("ID_USB_SERIAL_SHORT") or "").upper()
        port_path = port_path_from_devpath(props.get("DEVPATH", ""))
        rows.append({
            "dev": dev,
            "serial": serial,
            "sigil": serial_to_sigil.get(serial),
            "port_path": port_path,
            "warnings": port_warnings(port_path, dev),
        })
    return rows


def normalize_mac(s: str) -> str | None:
    m = re.fullmatch(r"(?:[0-9A-Fa-f]{2}[:\-]){5}[0-9A-Fa-f]{2}", s)
    return s.replace("-", ":").upper() if m else None


def resolve_selector(sel: str) -> tuple[str | None, str | None]:
    """Selector -> (sigil, serial). Accepts sigil, unique prefix, MAC, /dev/…"""
    if sel.startswith("/dev/"):
        return None, None            # handled by find_usb directly
    mac = normalize_mac(sel)
    if mac:
        for sigil, serial in FLEET.items():
            if serial.upper() == mac:
                return sigil, serial
        return None, mac             # foreign but explicit — allow
    matches = [s for s in FLEET if s == sel or s.startswith(sel)]
    if len(matches) == 1:
        return matches[0], FLEET[matches[0]]
    return None, None


def find_usb(sel: str, quiet: bool = False) -> dict | None:
    """Resolve a selector to a live USB row (None if absent/unknown)."""
    rows = usb_scan()
    if sel.startswith("/dev/"):
        for r in rows:
            if r["dev"] == sel:
                return r
        if not quiet:
            say(f"watchctl: {sel} is not an Espressif USB-Serial-JTAG device")
        return None
    sigil, serial = resolve_selector(sel)
    if serial is None:
        if not quiet:
            say(f"watchctl: unknown watch {sel!r} — known: "
                + ", ".join(FLEET))
        return None
    for r in rows:
        if r["serial"] == serial.upper():
            return r
    if not quiet:
        say(f"watchctl: {sigil or serial} is not on USB "
            "(ttyACM absent — check the cable/port; C6s can't enumerate on "
            f"the {KNOWN_BAD_HUB}.x hub or some mobo ports)")
    return None


def require_usb(sel: str) -> dict:
    row = find_usb(sel)
    if row is None:
        emit({"error": "not-found", "selector": sel})
        raise SystemExit(EXIT_NOTFOUND)
    for w in row["warnings"]:
        say(f"warning: {w}")
    return row


# --------------------------------------------------------------------------- #
# Tolerant serial reader (light-sleep gates serial on release builds: 0-byte
# reads are NORMAL; strip NULs + ANSI escapes so output stays grep-friendly)
# --------------------------------------------------------------------------- #
class LineReader:
    def __init__(self, dev: str):
        self.dev = dev
        self._buf = b""
        try:
            import serial  # type: ignore
            # exclusive=False ON PURPOSE: espflash must be able to open the
            # port while we hold it (the capture-before-reset pattern).
            self._ser = serial.Serial(dev, 115200, timeout=0.15, exclusive=False)
            self._mode = "pyserial"
        except ImportError:
            import termios
            import tty
            fd = os.open(dev, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
            tty.setraw(fd)
            attrs = termios.tcgetattr(fd)
            attrs[6][termios.VMIN] = 0
            attrs[6][termios.VTIME] = 0
            termios.tcsetattr(fd, termios.TCSANOW, attrs)
            self._fd = fd
            self._mode = "termios"

    def drain(self) -> None:
        self._buf = b""
        if self._mode == "pyserial":
            self._ser.reset_input_buffer()
        else:
            try:
                while os.read(self._fd, 4096):
                    pass
            except (BlockingIOError, OSError):
                pass

    def _read_some(self) -> bytes:
        if self._mode == "pyserial":
            try:
                return self._ser.read(512)
            except Exception:       # device vanished mid-read (replug/reset)
                time.sleep(0.1)
                return b""
        import select
        r, _, _ = select.select([self._fd], [], [], 0.15)
        if r:
            try:
                return os.read(self._fd, 512)
            except (BlockingIOError, OSError):
                return b""
        return b""

    @staticmethod
    def clean(raw: bytes) -> str:
        raw = ANSI_RE.sub(b"", raw).replace(b"\x00", b"")
        return raw.rstrip(b"\r").decode("utf-8", "replace")

    def lines_until(self, deadline: float):
        """Yield cleaned lines until the deadline. Tolerates 0-byte reads."""
        while True:
            nl = self._buf.find(b"\n")
            if nl >= 0:
                line, self._buf = self._buf[:nl], self._buf[nl + 1:]
                yield self.clean(line)
                continue
            if time.monotonic() > deadline:
                if self._buf.strip():
                    yield self.clean(self._buf)
                    self._buf = b""
                return
            self._buf += self._read_some()

    def close(self) -> None:
        try:
            if self._mode == "pyserial":
                self._ser.close()
            else:
                os.close(self._fd)
        except OSError:
            pass


# --------------------------------------------------------------------------- #
# Boot-banner capture (reader opens FIRST, then reset — the race is real)
# --------------------------------------------------------------------------- #
def scan_banner(reader: LineReader, wait: float, need: tuple[str, ...] = ("offset",),
                echo: bool = False, keep: int = 400) -> dict:
    found: dict = {"rom": False, "download": False, "offset": None,
                   "sigil": None, "node_id": None, "stack_gap": None,
                   "lines": []}
    deadline = time.monotonic() + wait
    for ln in reader.lines_until(deadline):
        if not ln.strip():
            continue
        if len(found["lines"]) < keep:
            found["lines"].append(ln)
        if echo:
            say(ln)
        if ROM_MARK in ln:
            found["rom"] = True
        if DOWNLOAD_MARK in ln:
            found["download"] = True
        m = BOOT_OFFSET_RE.search(ln)
        if m:
            found["offset"] = int(m.group(1), 16)
        m = SIGIL_RE.search(ln)
        if m:
            found["sigil"], found["node_id"] = m.group(1), int(m.group(2))
        m = STACK_RE.search(ln)
        if m:
            found["stack_gap"] = int(m.group(1))
        if all(found[k] not in (None, False) for k in need):
            break
    found["alive"] = bool(found["rom"] or found["offset"] is not None
                          or found["sigil"])
    return found


def reset_and_capture(dev: str, wait: float = 12.0,
                      need: tuple[str, ...] = ("offset",),
                      echo: bool = False) -> dict:
    """espflash reset with the boot burst captured. Reader opens BEFORE the
    reset (start-reader-then-reset — otherwise the burst is lost)."""
    try:
        reader = LineReader(dev)
    except (OSError, Exception) as e:  # noqa: BLE001
        return {"alive": False, "open_failed": str(e), "lines": [],
                "offset": None, "sigil": None, "stack_gap": None,
                "node_id": None, "rom": False, "download": False}
    try:
        reader.drain()
        try:
            p = espflash("reset", "--port", dev, timeout=30)
        except subprocess.TimeoutExpired:
            return {"alive": False, "reset_failed": "espflash reset timed out",
                    "lines": [], "offset": None, "sigil": None,
                    "stack_gap": None, "node_id": None, "rom": False,
                    "download": False}
        banner = scan_banner(reader, wait, need=need, echo=echo)
        if p.returncode != 0:
            banner["reset_failed"] = (p.stderr or p.stdout).strip()[-400:]
        return banner
    finally:
        reader.close()


def slot_of(offset: int | None) -> str | None:
    for name, off in SLOT_OFFSETS.items():
        if off == offset:
            return name
    return None


def fingerprint(banner: dict) -> dict:
    return {
        "slot": slot_of(banner.get("offset")),
        "offset": (hex(banner["offset"]) if banner.get("offset") is not None
                   else None),
        "sigil": banner.get("sigil"),
        "node_id": banner.get("node_id"),
        "stack_gap_bytes": banner.get("stack_gap"),
    }


def say_fingerprint(banner: dict) -> None:
    fp = fingerprint(banner)
    if fp["offset"]:
        say(f"  booting slot : {fp['slot'] or '?'} @ {fp['offset']}")
    if fp["sigil"]:
        say(f"  sigil        : {fp['sigil']} (node id {fp['node_id']})")
    if fp["stack_gap_bytes"] is not None:
        say(f"  stack gap    : {fp['stack_gap_bytes']} B "
            f"({fp['stack_gap_bytes'] // 1024} KB)")


# --------------------------------------------------------------------------- #
# The wedge recovery ladder (#21)
#   1. espflash reset (also un-parks a chip stuck in download mode)
#   2. USBDEVFS_RESET ioctl (host-side re-enumeration; needs sudo)
#   3. report power-cycle (battery devices do NOT reset on replug)
#   NEVER the sysfs `authorized` toggle — it hard-wedges into EPROTO.
# --------------------------------------------------------------------------- #
def usbdevfs_reset(port_path: str) -> tuple[bool, str]:
    base = Path("/sys/bus/usb/devices") / port_path
    try:
        busnum = int((base / "busnum").read_text())
        devnum = int((base / "devnum").read_text())
    except (OSError, ValueError) as e:
        return False, f"could not read busnum/devnum for {port_path}: {e}"
    node = f"/dev/bus/usb/{busnum:03d}/{devnum:03d}"
    code = ("import fcntl,os,sys\n"
            "fd=os.open(sys.argv[1],os.O_WRONLY)\n"
            f"fcntl.ioctl(fd,{USBDEVFS_RESET},0)\n"
            "os.close(fd)\n")
    try:
        p = run(["sudo", "-n", sys.executable, "-c", code, node], timeout=15)
    except subprocess.TimeoutExpired:
        return False, "sudo/ioctl timed out"
    if p.returncode != 0:
        return False, (p.stderr or p.stdout).strip() or "ioctl failed"
    return True, node


def wait_for_reenumeration(serial: str, timeout: float = 12.0) -> dict | None:
    """After a USB reset the ttyACM number may MOVE — re-resolve by serial."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        for r in usb_scan():
            if r["serial"] == serial.upper():
                return r
        time.sleep(0.5)
    return None


def recovery_ladder(row: dict, sel: str) -> tuple[int, dict]:
    """Walk the ladder; returns (exit_code, result_dict)."""
    result: dict = {"selector": sel, "sigil": row.get("sigil"),
                    "serial": row.get("serial"), "rungs": []}

    # Rung 1: espflash reset (twice if the chip was parked in download mode).
    say("rung 1: espflash reset + banner verify …")
    banner = reset_and_capture(row["dev"], wait=10.0)
    if banner.get("download"):
        say("  chip was parked in download mode — resetting again")
        banner = reset_and_capture(row["dev"], wait=10.0)
    result["rungs"].append({"rung": "espflash-reset", "alive": banner["alive"],
                            **fingerprint(banner)})
    if banner["alive"]:
        say("  OK — boot banner seen")
        say_fingerprint(banner)
        result["recovered_by"] = "espflash-reset"
        return EXIT_OK, result
    say("  no boot banner — escalating")

    # Rung 2: USBDEVFS_RESET (host-side re-enumeration).
    say("rung 2: USBDEVFS_RESET ioctl (host-side USB re-enumeration) …")
    ok, detail = usbdevfs_reset(row["port_path"])
    result["rungs"].append({"rung": "usbdevfs-reset", "ok": ok,
                            "detail": detail})
    if ok:
        say(f"  ioctl sent to {detail}; waiting for re-enumeration "
            "(the ttyACM number may move)")
        row2 = wait_for_reenumeration(row["serial"])
        if row2 is None:
            say("  device did not re-enumerate")
        else:
            if row2["dev"] != row["dev"]:
                say(f"  re-enumerated as {row2['dev']} (was {row['dev']})")
            banner = reset_and_capture(row2["dev"], wait=10.0)
            result["rungs"].append({"rung": "espflash-reset-after-usb-reset",
                                    "alive": banner["alive"],
                                    **fingerprint(banner)})
            if banner["alive"]:
                say("  OK — boot banner seen after USB reset")
                say_fingerprint(banner)
                result["recovered_by"] = "usbdevfs-reset"
                result["dev"] = row2["dev"]
                return EXIT_OK, result
    else:
        say(f"  ioctl failed: {detail}")

    # Rung 3: only power fully removes the wedge on a battery device.
    say("rung 3: POWER-CYCLE THE WATCH (battery + USB both off) — replugging "
        "USB does NOT reset the SoC on battery power.")
    say("        NEVER toggle sysfs 'authorized' — it hard-wedges EPROTO.")
    result["recovered_by"] = None
    result["action_needed"] = "power-cycle"
    return EXIT_RECOVERY, result


# --------------------------------------------------------------------------- #
# MQTT / ssh plumbing (via ubox0 — katana→VLAN-11 MQTT stalls mid-handshake,
# so all broker traffic rides the same ssh leg ota_push.sh uses)
# --------------------------------------------------------------------------- #
def mqtt_read_retained(args, topic: str, timeout: int = 4) -> str | None:
    cfg = cfg_path(args)
    broker = cfg_get(cfg, "MQTT_BROKER")
    if not broker:
        say(f"watchctl: MQTT_BROKER not set in {cfg} (gitignored — copy "
            ".cargo/config.example.toml and fill it in)")
        return None
    host, _, port = broker.partition(":")
    user, pw = cfg_get(cfg, "MQTT_USER"), cfg_get(cfg, "MQTT_PASS")
    inner = (f"mosquitto_sub -h {shlex.quote(host)} -p {shlex.quote(port or '1883')}"
             + (f" -u {shlex.quote(user)}" if user else "")
             + (f" -P {shlex.quote(pw)}" if pw else "")
             + f" -t {shlex.quote(topic)} -C 1 -W {timeout}")
    try:
        p = run(["ssh", "-o", "ConnectTimeout=6", OTA_HOST, inner],
                timeout=timeout + 12)
    except subprocess.TimeoutExpired:
        return None
    out = p.stdout.strip()
    return out or None


# --------------------------------------------------------------------------- #
# WiFi debug transport (client side; firmware server is the follow-on task —
# same line protocol as the serial debug console, port 5555, token-gated)
# --------------------------------------------------------------------------- #
def wifi_endpoint(args, sigil: str) -> str | None:
    return mqtt_read_retained(args, DEBUG_ENDPOINT_TOPIC.format(sigil=sigil))


def wifi_connect(endpoint: str, token: str | None, timeout: float = 4.0):
    import socket
    host, _, port = endpoint.partition(":")
    sock = socket.create_connection((host, int(port or DEBUG_TCP_PORT)),
                                    timeout=timeout)
    sock.settimeout(0.15)
    if token:
        sock.sendall(f"auth {token}\n".encode())
    return sock


class SocketReader:
    """LineReader-compatible wrapper over the WiFi debug socket."""

    def __init__(self, sock):
        self._sock = sock
        self._buf = b""

    def drain(self) -> None:
        self._buf = b""

    def _read_some(self) -> bytes:
        import socket
        try:
            data = self._sock.recv(512)
        except socket.timeout:
            return b""
        except OSError:
            return b""
        if data == b"":
            raise ConnectionError("debug link closed by the watch "
                                  "(auth reject / server stop)")
        return data

    def lines_until(self, deadline: float):
        while True:
            nl = self._buf.find(b"\n")
            if nl >= 0:
                line, self._buf = self._buf[:nl], self._buf[nl + 1:]
                yield LineReader.clean(line)
                continue
            if time.monotonic() > deadline:
                return
            self._buf += self._read_some()

    def send_line(self, s: str) -> None:
        self._sock.sendall((s + "\n").encode())

    def close(self) -> None:
        try:
            self._sock.close()
        except OSError:
            pass


def resolve_transport(args, sel: str) -> tuple[str, dict]:
    """-> ("usb", usb_row) or ("wifi", {"endpoint":…, "token":…, "sigil":…}).

    USB-only commands must NOT call this — they call require_usb directly."""
    mode = getattr(args, "transport", "auto") or "auto"
    if mode in ("usb", "auto"):
        row = find_usb(sel, quiet=(mode == "auto"))
        if row is not None:
            for w in row["warnings"]:
                say(f"warning: {w}")
            return "usb", row
        if mode == "usb":
            emit({"error": "not-found", "selector": sel, "transport": "usb"})
            raise SystemExit(EXIT_NOTFOUND)
    sigil, _ = resolve_selector(sel)
    if sigil is None:
        say(f"watchctl: unknown watch {sel!r} — known sigils: "
            + ", ".join(FLEET) + " (WiFi transport needs a fleet sigil)")
        emit({"error": "not-found", "selector": sel})
        raise SystemExit(EXIT_NOTFOUND)
    if mode == "auto":
        say(f"{sigil} not on USB — trying the WiFi debug endpoint …")
    ep = wifi_endpoint(args, sigil)
    if ep is None:
        say(f"watchctl: no retained debug endpoint for {sigil} "
            f"(topic watch/{sigil}/debug/endpoint) — the firmware debug "
            "server is not running (or not built yet; see docs/debugging.md "
            "'WiFi debug channel')")
        emit({"error": "no-endpoint", "selector": sel, "sigil": sigil})
        raise SystemExit(EXIT_NOTFOUND)
    return "wifi", {"endpoint": ep, "token": debug_token(args), "sigil": sigil}


