def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true",
                        default=argparse.SUPPRESS,
                        help="machine output (JSON on stdout, chatter on stderr)")
    common.add_argument("--transport", choices=("usb", "wifi", "auto"),
                        default=argparse.SUPPRESS,
                        help="usb | wifi | auto (default auto; reset/recover/"
                             "slot/deploy/flash-full are USB-only)")
    common.add_argument("--config", default=argparse.SUPPRESS,
                        help="path to .cargo/config.toml (default: repo copy; "
                             "env WATCHCTL_CONFIG)")
    common.add_argument("-v", "--verbose", action="store_true",
                        default=argparse.SUPPRESS,
                        help="echo commands and raw serial to stderr")

    ap = argparse.ArgumentParser(
        prog="watchctl",
        parents=[common],
        description="one-command USB/WiFi debug rig for the esp32c6-watch "
                    "fleet (see docs/debugging.md)")
    # NO ap.set_defaults() for the common flags: parents=[] SHARES the action
    # objects, and set_defaults would mutate their SUPPRESS defaults — the
    # subparser would then clobber a pre-subcommand `--json` back to False.
    # main() getattr()s the fallbacks instead.
    sub = ap.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", parents=[common],
                   help="fleet presence, ports, port-path warnings")

    p = sub.add_parser("logs", parents=[common],
                       help="capture serial/WiFi log lines (grep-friendly)")
    p.add_argument("watch", help="sigil | serial | /dev/ttyACM*")
    p.add_argument("--seconds", type=float, default=10.0,
                   help="capture window (default 10)")
    p.add_argument("--reset", action="store_true",
                   help="reset first, capturing the boot burst (USB only)")

    p = sub.add_parser("reset", parents=[common],
                       help="verified reset; auto-escalates the wedge ladder")
    p.add_argument("watch")

    p = sub.add_parser("recover", parents=[common],
                       help="the full #21 recovery ladder, explicitly")
    p.add_argument("watch")

    p = sub.add_parser("slot", parents=[common],
                       help="booting slot + offset + build fingerprint "
                            "(resets the watch)")
    p.add_argument("watch")

    p = sub.add_parser("deploy", parents=[common],
                       help="slot-trap-proof deploy: write-bin into the "
                            "BOOTING slot + boot verify")
    p.add_argument("watch")
    p.add_argument("image", help="ELF (auto save-image) or app .bin")
    p.add_argument("--allow-never-ship", action="store_true",
                   help="flash an image carrying a NEVER-SHIP marker (test builds "
                        "only; the watch will render a known-bad frame)")
    p.add_argument("--slot", default="auto",
                   help="auto (detect booting slot) | 0 | 1 | ota_0 | ota_1 "
                        "| 0x10000 | 0x410000")

    p = sub.add_parser("flash-full", parents=[common],
                       help="full espflash flash WITH partitions.csv "
                            "(provisioning / fresh devices)")
    p.add_argument("watch")
    p.add_argument("elf")
    p.add_argument("--erase-otadata", action="store_true",
                   help="also erase otadata (boot pointer back to ota_0)")

    p = sub.add_parser("console", parents=[common],
                       help="debug-console REPL (wraps tools/ui_test.py)")
    p.add_argument("watch")

    p = sub.add_parser("test", parents=[common],
                       help="ui_test.py suites: default | hotpaths | lights")
    p.add_argument("watch")
    p.add_argument("suite", nargs="?", default="default")

    p = sub.add_parser("soak", parents=[common],
                       help="boot-stability harness: reset N times, report crash-rate")
    p.add_argument("watch")
    p.add_argument("-n", "--trials", type=int, default=6,
                   help="boot trials (default 6)")
    p.add_argument("-s", "--seconds", type=float, default=50.0,
                   help="watch seconds per boot (default 50 — must exceed the "
                        "failure latency or the soak reports false 'stable'; #65)")

    p = sub.add_parser("ota-status", parents=[common],
                       help="ubox0 watch-ota journal + retained OTA announce")
    p.add_argument("-n", "--lines", type=int, default=15,
                   help="journal lines (default 15)")

    p = sub.add_parser("endpoint", parents=[common],
                       help="WiFi debug endpoint: retained lookup + "
                            "connect/auth/ping probe")
    p.add_argument("watch")

    return ap


def main(argv: list[str] | None = None) -> int:
    global JSON_MODE, VERBOSE
    args = build_parser().parse_args(argv)
    JSON_MODE = getattr(args, "json", False)
    VERBOSE = getattr(args, "verbose", False)

    handlers = {
        "list": cmd_list,
        "logs": cmd_logs,
        "reset": cmd_reset,
        "recover": cmd_recover,
        "slot": cmd_slot,
        "deploy": cmd_deploy,
        "flash-full": cmd_flash_full,
        "console": cmd_console,
        "test": cmd_test,
        "soak": cmd_soak,
        "ota-status": cmd_ota_status,
        "endpoint": cmd_endpoint,
    }
    try:
        return handlers[args.cmd](args)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
